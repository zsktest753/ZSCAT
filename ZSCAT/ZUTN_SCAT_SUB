*&---------------------------------------------------------------------*
*&      Form  get_from_tadir
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM z_get_from_tadir .

  APPEND LINES OF it_obj TO it_obj_dup.

  SORT it_obj_dup BY object obj_name.
  DELETE ADJACENT DUPLICATES FROM it_obj_dup COMPARING object obj_name.

* Checking for z/y objects
  CLEAR: wa_obj.
  LOOP AT it_obj_dup INTO wa_obj.
    IF wa_obj-obj_name+0(1)  = c_z OR
       wa_obj-obj_name+0(1)  = c_y OR
       wa_obj-obj_name+0(2)  = c_lz OR
(      wa_obj-obj_name+4(1) = c_z AND
       wa_obj-obj_name+0(1)  = c_s ) OR
       wa_obj-obj_name+0(2)  = c_zz  OR "added by SAG on 16Aug
       wa_obj-obj_name+0(2) = 'RV'. "added by SAG on 16Aug

      wa_obj-genflag = c_x.
      MODIFY it_obj_dup FROM wa_obj.
    ENDIF.
  ENDLOOP.

  DELETE it_obj_dup WHERE genflag <> c_x.

*Includes and Structures are treated as Programs and Tables while
*storing in Tadir table

  LOOP AT it_obj_dup INTO wa_obj.
    IF wa_obj-object EQ c_incl.
      wa_obj-object = c_prog.
    ELSEIF wa_obj-object EQ c_stru.
      wa_obj-object = c_tabl.
    ENDIF.
    MODIFY it_obj_dup FROM wa_obj TRANSPORTING object.
  ENDLOOP.

  CLEAR: it_tadir.

  IF NOT it_obj_dup IS INITIAL.

    SELECT object obj_name devclass
      FROM tadir
      INTO TABLE it_tadir
       FOR ALL ENTRIES IN it_obj_dup
     WHERE pgmid    = c_r3tr            AND
           object   = it_obj_dup-object AND
           obj_name = it_obj_dup-obj_name.

    IF sy-subrc EQ 0.
      SORT it_tadir BY object obj_name devclass.
      DELETE ADJACENT DUPLICATES FROM it_tadir COMPARING ALL FIELDS.
    ENDIF."sy-subrc EQ 0.
  ENDIF." NOT it_obj_dup IS INITIAL.


ENDFORM.                    " get_from_tadir


