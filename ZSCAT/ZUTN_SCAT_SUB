*&      Form  Z_LOG_FEATURE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM z_log_feature .

  DATA: lwa_log TYPE ztut_scat_log.

  CLEAR lwa_log.
  lwa_log-uname = sy-uname.
  lwa_log-zdate = sy-datum.
  lwa_log-ztime = sy-uzeit.

*ABAP RFC Connection Test
  IF p_rfct = abap_true.
    lwa_log-feature = text-002.
    lwa_log-sub_feature = 'N/A'.
  ENDIF.

*Comparisons
  IF p_comp = abap_true.
    lwa_log-feature = 'Comparisons'.

*Table Entries Comparison
    IF p_gen = abap_true AND p_tab = abap_true.
      lwa_log-sub_feature = 'Table Entries Comparison'.
*Variant Comparison
    ELSEIF p_gen = abap_true AND p_var = abap_true.
      lwa_log-sub_feature = 'Variant Comparison'.
*Graphic Comparison
    ELSEIF p_gen = abap_true AND p_grap = abap_true.
      lwa_log-sub_feature = 'Graphic Comparison'.
*Standard Text Comparison
    ELSEIF p_gen = abap_true AND p_text = abap_true.
      lwa_log-sub_feature = 'Standard Text Comparison'.
*Custom Page Format Comparison
    ELSEIF p_gen = abap_true AND p_page = abap_true.
      lwa_log-sub_feature = 'Custom Page Format Comparison'.
*Partner Profile Comparison
    ELSEIF p_int = abap_true AND p_pprf = abap_true.
      lwa_log-sub_feature = 'Partner Profile Comparison'.
*Distribution Model Comparison
    ELSEIF p_int = abap_true AND p_dimo = abap_true.
      lwa_log-sub_feature = 'Distribution Model Comparison'.
*Ext. OS Commands Comparison
    ELSEIF p_gen = abap_true AND p_extc = abap_true.
      lwa_log-sub_feature = 'Ext. OS Commands Comparison'.
*Message Classes Comparison
    ELSEIF p_gen = abap_true AND p_mesg = abap_true.
      lwa_log-sub_feature = 'Message Classes Comparison'.
    ELSEIF p_gen = abap_true AND p_aelc = abap_true.  " Begin of santosh
      lwa_log-sub_feature = 'WF Event Linkages Comparison'. " End of Santosh
    ENDIF.
  ENDIF.

*Transport Utility
  IF p_util = abap_true.
    lwa_log-feature = 'Transport Utility'.

*Status of Released Transports
    IF p_sort = abap_true.
      lwa_log-sub_feature = 'Status of Released Transports'.
*List of Open Transports
    ELSEIF p_lopt = abap_true.
      lwa_log-sub_feature = 'List of Open Transports '.
*Dependency in Quality - By Obj
    ELSEIF p_dqob = abap_true.
      lwa_log-sub_feature = 'Dependency in Quality - By Obj '.
*Dependency in DEV
    ELSEIF p_ddev = abap_true.
      lwa_log-sub_feature = 'Dependency in DEV '.
    ENDIF.
  ENDIF.

* Start of BSINGH-14-JAN-2017 (+)

  IF p_cchk IS NOT INITIAL.
    lwa_log-feature = 'Source Code Comparison Utility'.

    IF p_prog IS NOT INITIAL.
      lwa_log-sub_feature = 'Program'.
    ELSEIF p_func IS NOT INITIAL.
      lwa_log-sub_feature = 'Function'.
    ELSEIF p_fugr IS NOT INITIAL.
      lwa_log-sub_feature = 'Function Group'.
    ELSEIF p_clas IS NOT INITIAL.
      lwa_log-sub_feature = 'Class'.
    ELSEIF p_pck IS NOT INITIAL.
      lwa_log-sub_feature = 'Package'.
    ENDIF."p_prog IS NOT INITIAL

  ENDIF."p_cchk IS NOT INITIAL

* End of BSINGH-14-JAN-2017 (+)

*Other Utilities
  IF p_othr = abap_true.
    lwa_log-feature = 'Other Utilities'.

*Objects in $TMP
    IF p_tmp = abap_true.
      lwa_log-sub_feature = 'Objects in $TMP'.
*Unlocked Standard Texts
    ELSEIF p_sttp = abap_true.
      lwa_log-sub_feature = 'Unlocked Standard Texts'.
    ENDIF.
  ENDIF.

  IF lwa_log IS NOT INITIAL.
    CALL FUNCTION 'ENQUEUE_E_TABLEE'
      EXPORTING
        mode_rstable   = 'E'
        tabname        = 'ZTUT_SCAT_LOG'
      EXCEPTIONS
        foreign_lock   = 1
        system_failure = 2
        OTHERS         = 3.
    IF sy-subrc = 0.
      INSERT INTO ztut_scat_log VALUES lwa_log.
      IF sy-subrc = 0.
        CLEAR lwa_log.
      ENDIF.
      CALL FUNCTION 'DEQUEUE_E_TABLEE'
        EXPORTING
          mode_rstable = 'E'
          tabname      = 'ZTUT_SCAT_LOG'.
    ENDIF.
  ENDIF.

ENDFORM.                    " Z_LOG_FEATURE
*&---------------------------------------------------------------------*
*&      Form  Z_COMPARE_WFEVENTS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM z_compare_wfevents .

  CONSTANTS: lc_y    TYPE c LENGTH 2 VALUE 'Y%',
             lc_z    TYPE c LENGTH 2 VALUE 'Z%',
             lc_r3tr TYPE c LENGTH 4 VALUE 'R3TR',
             lc_pdws TYPE c LENGTH 4 VALUE 'PDWS'.
*             lc_bcol  type tdbtype value 'BCOL',
*             lc_bmon  type tdbtype value 'BMON',
*             lc_color type c length 20 value 'Color Bitmap',
*             lc_bw    type c length 20 value 'B/W Bitmap'.

  DATA: l_table      TYPE dd02l-tabname,
        lit_opt      TYPE TABLE OF rfc_db_opt,
        lit_fld      TYPE TABLE OF rfc_db_fld,
        lit_source   TYPE TABLE OF tab512,
        lit_src      TYPE TABLE OF t_wfevents,
        lit_tadirs   TYPE TABLE OF t_tadir,
        lit_target   TYPE TABLE OF tab512,
        lit_tar      TYPE TABLE OF t_wfevents,
        lit_tadirt   TYPE TABLE OF t_tadir,
        lwa_src      TYPE t_wfevents,
        lwa_tar      TYPE t_wfevents,
        lwa_tadirs   TYPE t_tadir,
        lwa_tadirt   TYPE t_tadir,
        lwa_opt      TYPE rfc_db_opt,
        lwa_fld      TYPE rfc_db_fld,
        l_type       TYPE tdbtype,
        l_sourcetext TYPE scrtext_l,
        l_targettext TYPE scrtext_l.



  FIELD-SYMBOLS: <lfs_source> TYPE tab512,
                 <lfs_target> TYPE tab512.

  CLEAR: l_sourcetext,l_targettext.

* Populate the table to be used

  MOVE: 'TADIR' TO l_table.

* Populate the field list

  CLEAR: lwa_fld.
  MOVE: 'PGMID' TO  lwa_fld-fieldname,
        '4'     TO  lwa_fld-length.
  APPEND  lwa_fld TO lit_fld.

  CLEAR:  lwa_fld.
  MOVE: 'OBJECT' TO  lwa_fld-fieldname,
        '4'   TO lwa_fld-length.
  APPEND lwa_fld TO lit_fld.

  CLEAR:  lwa_fld.
  MOVE: 'OBJ_NAME' TO  lwa_fld-fieldname,
        '40'   TO lwa_fld-length.
  APPEND lwa_fld TO lit_fld.

  CLEAR:  lwa_fld.
  MOVE: 'AUTHOR' TO  lwa_fld-fieldname,
        '12'   TO lwa_fld-length.
  APPEND lwa_fld TO lit_fld.

  CLEAR:  lwa_fld.
  MOVE: 'DEVCLASS' TO  lwa_fld-fieldname,
        '30'   TO lwa_fld-length.
  APPEND lwa_fld TO lit_fld.

* Populate the condition for data fetching

  CLEAR: lwa_opt.

  CONCATENATE 'PGMID EQ ''' lc_r3tr c_comma ' AND OBJECT EQ''' lc_pdws c_comma INTO lwa_opt-text.
  APPEND lwa_opt TO lit_opt.
  CLEAR: lwa_opt.

  CONCATENATE 'AND DEVCLASS LIKE ''' lc_z c_comma INTO lwa_opt-text.
  APPEND lwa_opt TO lit_opt.
  CLEAR: lwa_opt.

* Perform read table from source and destination

  PERFORM z_read_tables USING l_table lit_opt lit_opt lit_fld p_scrfc p_tcrfc CHANGING lit_source lit_target.

* Delete duplicates
  LOOP AT lit_source
    ASSIGNING <lfs_source>.

    IF <lfs_source> IS ASSIGNED.
      MOVE: <lfs_source>+0(4)   TO lwa_tadirs-pgmid,
            <lfs_source>+4(4)   TO lwa_tadirs-object,
            <lfs_source>+6(42)  TO lwa_tadirs-obj_name,
            <lfs_source>+48(12) TO lwa_tadirs-author,
            <lfs_source>+60(30) TO lwa_tadirs-devclass.
      APPEND lwa_tadirs TO lit_tadirs.
      CLEAR lwa_tadirs.
    ENDIF."<lfs_source> IS ASSIGNED.
  ENDLOOP."lit_source ASSIGNING <lfs_source>.

  LOOP AT lit_target
    ASSIGNING <lfs_target>.

    IF <lfs_source> IS ASSIGNED.
      MOVE: <lfs_target>+0(4)   TO lwa_tadirt-pgmid,
            <lfs_target>+4(4)   TO lwa_tadirt-object,
            <lfs_target>+6(42)  TO lwa_tadirt-obj_name,
            <lfs_target>+48(12) TO lwa_tadirt-author,
            <lfs_target>+60(30) TO lwa_tadirt-devclass.
      APPEND lwa_tadirt TO lit_tadirt.
      CLEAR lwa_tadirt.
    ENDIF."<lfs_source> IS ASSIGNED.
  ENDLOOP."lit_source ASSIGNING <lfs_source>.

  CLEAR: lit_source, lit_target, lit_opt.

* Populate the condition for data fetching

  CLEAR: lwa_opt.

  CONCATENATE 'PGMID EQ ''' lc_r3tr c_comma ' AND OBJECT EQ''' lc_pdws c_comma INTO lwa_opt-text.
  APPEND lwa_opt TO lit_opt.
  CLEAR: lwa_opt.

  CONCATENATE 'AND DEVCLASS LIKE ''' lc_y c_comma INTO lwa_opt-text.
  APPEND lwa_opt TO lit_opt.
  CLEAR: lwa_opt.

* Perform read table from source and destination

  PERFORM z_read_tables USING l_table lit_opt lit_opt lit_fld p_scrfc p_tcrfc CHANGING lit_source lit_target.

* Delete duplicates
  LOOP AT lit_source
    ASSIGNING <lfs_source>.

    IF <lfs_source> IS ASSIGNED.
      MOVE: <lfs_source>+0(4)   TO lwa_tadirs-pgmid,
            <lfs_source>+4(4)   TO lwa_tadirs-object,
            <lfs_source>+6(42)  TO lwa_tadirs-obj_name,
            <lfs_source>+48(12) TO lwa_tadirs-author,
            <lfs_source>+60(30) TO lwa_tadirs-devclass.
      APPEND lwa_tadirs TO lit_tadirs.
      CLEAR lwa_tadirs.
    ENDIF."<lfs_source> IS ASSIGNED.
  ENDLOOP."lit_source ASSIGNING <lfs_source>.

  LOOP AT lit_target
    ASSIGNING <lfs_target>.

    IF <lfs_source> IS ASSIGNED.
      MOVE: <lfs_target>+0(4)   TO lwa_tadirt-pgmid,
            <lfs_target>+4(4)   TO lwa_tadirt-object,
            <lfs_target>+6(42)  TO lwa_tadirt-obj_name,
            <lfs_target>+48(12) TO lwa_tadirt-author,
            <lfs_target>+60(30) TO lwa_tadirt-devclass.
      APPEND lwa_tadirt TO lit_tadirt.
      CLEAR lwa_tadirt.
    ENDIF."<lfs_source> IS ASSIGNED.
  ENDLOOP."lit_source ASSIGNING <lfs_source>.

  CLEAR: lit_source, lit_target, lit_opt, lit_fld.
  CLEAR: l_table.

  CLEAR: l_sourcetext,
         l_targettext.
* Populate the table to be used

  MOVE: 'SWFDEVTYP' TO l_table.

* Populate the field list

  CLEAR: lwa_fld.
  MOVE: 'OBJCATEG' TO  lwa_fld-fieldname,
        '2'   TO  lwa_fld-length.
  APPEND  lwa_fld TO lit_fld.

  CLEAR:  lwa_fld.
  MOVE: 'OBJTYPE' TO  lwa_fld-fieldname,
        '32'   TO lwa_fld-length.
  APPEND lwa_fld TO lit_fld.

  CLEAR:  lwa_fld.
  MOVE: 'EVENT' TO  lwa_fld-fieldname,
        '32'   TO lwa_fld-length.
  APPEND lwa_fld TO lit_fld.

  CLEAR:  lwa_fld.
  MOVE: 'RECTYPE' TO  lwa_fld-fieldname,
        '32'   TO lwa_fld-length.
  APPEND lwa_fld TO lit_fld.

  CLEAR:  lwa_fld.
  MOVE: 'RECFB' TO  lwa_fld-fieldname,
        '30'   TO lwa_fld-length.
  APPEND lwa_fld TO lit_fld.

  CLEAR:  lwa_fld.
  MOVE: 'CHECKFB' TO  lwa_fld-fieldname,
        '30'   TO lwa_fld-length.
  APPEND lwa_fld TO lit_fld.

  CLEAR:  lwa_fld.
  MOVE: 'TYPELINK' TO  lwa_fld-fieldname,
        '1'   TO lwa_fld-length.
  APPEND lwa_fld TO lit_fld.

  CLEAR:  lwa_fld.
  MOVE: 'REC_ERROR' TO  lwa_fld-fieldname,
        '3'   TO lwa_fld-length.
  APPEND lwa_fld TO lit_fld.
* Populate the condition for data fetching

*  clear: lwa_opt.
*
*  concatenate 'TDNAME LIKE ''' lc_z c_comma ' OR TDNAME LIKE ''' lc_y c_comma into lwa_opt-text.
*  append lwa_opt to lit_opt.
*  clear: lwa_opt.

* Perform read table from source and destination

  PERFORM z_read_tables USING l_table lit_opt lit_opt lit_fld p_scrfc p_tcrfc CHANGING lit_source lit_target.
  SORT lit_target BY wa.
* Delete duplicates
  LOOP AT lit_source
    ASSIGNING <lfs_source>.

    IF <lfs_source> IS ASSIGNED.
      READ TABLE lit_target ASSIGNING <lfs_target> WITH KEY wa = <lfs_source> BINARY SEARCH.
      IF sy-subrc EQ 0 AND <lfs_target> IS ASSIGNED.
        DELETE lit_target INDEX sy-tabix.
        DELETE lit_source.
      ENDIF.
    ENDIF."<lfs_source> IS ASSIGNED.
  ENDLOOP."lit_source ASSIGNING <lfs_source>.

* Populate final table
  LOOP AT lit_source
    ASSIGNING <lfs_source>.
    CLEAR: lwa_src.
    IF <lfs_source> IS ASSIGNED.

      MOVE: <lfs_source>+0(2)    TO lwa_src-objcateg,
            <lfs_source>+2(32)   TO lwa_src-objtype,
            <lfs_source>+34(32)  TO lwa_src-event,
            <lfs_source>+66(32)  TO lwa_src-rectype,
            <lfs_source>+98(30)  TO lwa_src-recfb,
            <lfs_source>+128(30) TO lwa_src-checkfb,
            <lfs_source>+158(1)  TO lwa_src-typelink.
*            'C410'               to lwa_src-line_color.

      CASE <lfs_source>+159(3).
        WHEN 0.
          MOVE 'System defaults' TO lwa_src-rec_error.
        WHEN 1.
          MOVE 'Deactivation of linkage' TO lwa_src-rec_error.
        WHEN 2.
          MOVE 'Mark linkage as having errors' TO lwa_src-rec_error.
        WHEN 3.
          MOVE 'Do not change linkage' TO lwa_src-rec_error.
      ENDCASE.
      lwa_src-source = 'Yes'.
      lwa_src-target = 'No'.

      SORT lit_tadirs BY obj_name.

      READ TABLE lit_tadirs TRANSPORTING NO FIELDS
      WITH KEY obj_name = lwa_src-rectype BINARY SEARCH.
      IF sy-subrc EQ 0.
        APPEND lwa_src TO it_final_wf.
      ENDIF.
      CLEAR lwa_src.

    ENDIF."<lfs_source> IS ASSIGNED.

  ENDLOOP."lit_source ASSIGNING <lfs_source>.

  LOOP AT lit_target ASSIGNING <lfs_target>.
    CLEAR: lwa_tar.
    IF <lfs_target> IS ASSIGNED.

      MOVE: <lfs_target>+0(2)    TO lwa_tar-objcateg,
            <lfs_target>+2(32)   TO lwa_tar-objtype,
            <lfs_target>+34(32)  TO lwa_tar-event,
            <lfs_target>+66(32)  TO lwa_tar-rectype,
            <lfs_target>+98(30)  TO lwa_tar-recfb,
            <lfs_target>+128(30) TO lwa_tar-checkfb,
            <lfs_target>+158(1)  TO lwa_tar-typelink,
            <lfs_target>+159(3)  TO lwa_tar-rec_error.
*            'C500'               to lwa_tar-line_color.

      CASE <lfs_target>+159(3).
        WHEN 0.
          MOVE 'System defaults' TO lwa_tar-rec_error.
        WHEN 1.
          MOVE 'Deactivation of linkage' TO lwa_tar-rec_error.
        WHEN 2.
          MOVE 'Mark linkage as having errors' TO lwa_tar-rec_error.
        WHEN 3.
          MOVE 'Do not change linkage' TO lwa_tar-rec_error.
        WHEN OTHERS.
          MOVE: space TO lwa_tar-rec_error.
      ENDCASE.
      READ TABLE it_final_wf INTO lwa_src WITH KEY rectype = lwa_tar-rectype.
      IF sy-subrc EQ 0.
        lwa_tar-source = 'Yes'.
        lwa_tar-target = 'Yes'.
      ELSE.
        lwa_tar-source = 'No'.
        lwa_tar-target = 'Yes'.
      ENDIF.

      SORT lit_tadirt BY obj_name.

      READ TABLE lit_tadirt TRANSPORTING NO FIELDS
      WITH KEY obj_name = lwa_tar-rectype BINARY SEARCH.
      IF sy-subrc EQ 0.
        APPEND lwa_tar TO it_final_wf.
      ENDIF.
      CLEAR lwa_tar.

    ENDIF."<lfs_target> IS ASSIGNED.

  ENDLOOP."lit_target ASSIGNING <lfs_target>.

  SORT it_final_wf BY objtype event rectype.

  IF  it_final_wf IS NOT INITIAL.

    CLEAR it_fieldcat.

    PERFORM z_fieldcat USING 'OBJCATEG'  'Object Category'       'IT_FINAL_WF'  18 c_x space.
    PERFORM z_fieldcat USING 'OBJTYPE'   'Type of Objects'       'IT_FINAL_WF'  18 c_x space.
    PERFORM z_fieldcat USING 'EVENT'     'Event'       'IT_FINAL_WF'  18 c_x space.
    PERFORM z_fieldcat USING 'RECTYPE'   'Name of Receiver Type'       'IT_FINAL_WF'  18 c_x space.
    PERFORM z_fieldcat USING 'TYPELINK'  'Event Linkage'       'IT_FINAL_WF'  18 c_x space.
    PERFORM z_fieldcat USING 'RECFB'     'Name of Receiver Function Module'       'IT_FINAL_WF'  18 c_x space.
    PERFORM z_fieldcat USING 'CHECKFB'   'Name of Check Function Module'       'IT_FINAL_WF'  18 c_x space.
    PERFORM z_fieldcat USING 'REC_ERROR' 'Behavior Upon Error'       'IT_FINAL_WF'  18 c_x space.
    PERFORM z_fieldcat USING 'SOURCE' 'Source'       'IT_FINAL_WF'  5 c_x space.
    PERFORM z_fieldcat USING 'TARGET' 'Target'       'IT_FINAL_WF'  5 c_x space.

    CLEAR wa_sort.
    CLEAR it_sort.

    PERFORM z_output_alv TABLES it_final_wf.
  ELSE.
    MESSAGE 'There are no differences in the list of worfklow event linkages between the two systems' TYPE 'I'.

  ENDIF. "it_final_gra IS NOT INITIAL.


ENDFORM.                    " Z_COMPARE_WFEVENTS
*&---------------------------------------------------------------------*
*&      Form  Z_COMPARE_PORTS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM z_compare_ports .

  DATA: l_table      TYPE dd02l-tabname,
        lit_opt      TYPE TABLE OF rfc_db_opt,
        lit_fld      TYPE TABLE OF rfc_db_fld,
        lit_source   TYPE TABLE OF tab512,
        lit_tadirs   TYPE TABLE OF t_tadir,
        lit_target   TYPE TABLE OF tab512,
        lit_tadirt   TYPE TABLE OF t_tadir,

        lwa_src      TYPE t_port,
        lwa_tar      TYPE t_port,
        lwa_tadirs   TYPE t_tadir,
        lwa_tadirt   TYPE t_tadir,
        lwa_opt      TYPE rfc_db_opt,
        lwa_fld      TYPE rfc_db_fld,
        l_type       TYPE tdbtype,
        l_sourcetext TYPE scrtext_l,
        l_targettext TYPE scrtext_l.

  FIELD-SYMBOLS: <lfs_source> TYPE tab512,
                 <lfs_target> TYPE tab512.

  CLEAR: l_sourcetext,l_targettext.

  MOVE: 'EDIPORT' TO l_table.

  CLEAR: lwa_fld.
  MOVE: 'PORT'    TO  lwa_fld-fieldname,
        '10'      TO  lwa_fld-length.
  APPEND  lwa_fld TO lit_fld.

  CLEAR: lwa_fld.
  MOVE: 'PORTTYP' TO  lwa_fld-fieldname,
        '1'       TO  lwa_fld-length.
  APPEND  lwa_fld TO lit_fld.

  CLEAR: lwa_fld.
  MOVE: 'DESCRI'  TO  lwa_fld-fieldname,
        '50'      TO  lwa_fld-length.
  APPEND  lwa_fld TO lit_fld.

  PERFORM z_read_tables USING l_table lit_opt lit_opt lit_fld p_scrfc p_tcrfc CHANGING lit_source lit_target.

  LOOP AT lit_source ASSIGNING <lfs_source>.
    IF <lfs_source> IS ASSIGNED.
      MOVE: <lfs_source>+0(10)   TO lwa_src-port,
            <lfs_source>+10(1)   TO lwa_src-porttyp,
            <lfs_source>+11(50)  TO lwa_src-descri.
      lwa_src-source = 'Yes'.
      lwa_src-target = 'No'.

      APPEND lwa_src TO it_port.
      CLEAR lwa_src.
    ENDIF.
  ENDLOOP.

  LOOP AT lit_target ASSIGNING <lfs_target>.
    IF <lfs_target> IS ASSIGNED.
      MOVE: <lfs_target>+0(10)   TO lwa_src-port,
            <lfs_target>+10(1)   TO lwa_src-porttyp,
            <lfs_target>+11(50)  TO lwa_src-descri.
      READ TABLE it_port INTO lwa_tar WITH KEY port = lwa_src-port
                                              porttyp = lwa_src-porttyp.
      IF sy-subrc EQ 0.
        lwa_src-source = 'Yes'.
        lwa_src-target = 'Yes'.
      ELSE.
        lwa_src-source = 'No'.
        lwa_src-target = 'Yes'.
      ENDIF.

      APPEND lwa_src TO it_port.
      CLEAR lwa_src.
    ENDIF.
  ENDLOOP.

  SORT it_port BY porttyp port.

  IF  it_port IS NOT INITIAL.

    CLEAR it_fieldcat.

    PERFORM z_fieldcat USING 'PORT'      'Port'             'IT_PORT'  10 c_x space.
    PERFORM z_fieldcat USING 'PORTTYP'   'Port type'        'IT_PORT'  10 c_x space.
    PERFORM z_fieldcat USING 'DESCRI'    'Port description' 'IT_PORT'  50 c_x space.
    PERFORM z_fieldcat USING 'SOURCE'    'Source'           'IT_PORT'  5 c_x space.
    PERFORM z_fieldcat USING 'TARGET'    'Target'           'IT_PORT'  5 c_x space.

    CLEAR wa_sort.
    CLEAR it_sort.

    PERFORM z_output_alv TABLES it_port.
  ELSE.
    MESSAGE 'There are no differences Ports between the two systems' TYPE 'I'.

  ENDIF.

ENDFORM.                    " Z_COMPARE_PORTS
