*&---------------------------------------------------------------------*
*&      Form  Z_COMPARE_VOFMROUTINES
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM z_compare_vofmroutines .

  DATA: l_table      TYPE dd02l-tabname,
        lit_opt      TYPE TABLE OF rfc_db_opt,
        lit_fld      TYPE TABLE OF rfc_db_fld,
        lit_source   TYPE TABLE OF tab512,
        lit_target   TYPE TABLE OF tab512,
        lit_dd07v    TYPE STANDARD TABLE OF dd07v,
        lit_tfrmt    TYPE STANDARD TABLE OF tfrmt,
        lwa_tfrmt    TYPE tfrmt,
        lwa_dd07v    TYPE dd07v,
        lwa_opt      TYPE rfc_db_opt,
        lwa_fld      TYPE rfc_db_fld,
        lwa_vofm     TYPE t_final_vofm,
        l_type       TYPE tdbtype,
        l_sourcetext TYPE scrtext_l,
        l_targettext TYPE scrtext_l.



  FIELD-SYMBOLS: <lfs_source> TYPE tab512,
                 <lfs_target> TYPE tab512.

  CLEAR: l_sourcetext,
         l_targettext.

*"Populate the table to be used
  MOVE: 'TFRM' TO l_table.

*"Populate the field list
  CLEAR: lwa_fld.

  MOVE: 'GRPZE'  TO  lwa_fld-fieldname,
        '4'         TO  lwa_fld-length   .

  APPEND  lwa_fld   TO lit_fld.

  CLEAR:  lwa_fld.

  MOVE: 'GRPNO' TO  lwa_fld-fieldname,
        '3'   TO lwa_fld-length.

  APPEND lwa_fld TO lit_fld.

  CLEAR:  lwa_fld.

  MOVE: 'AKTIV' TO  lwa_fld-fieldname,
        '1'   TO lwa_fld-length.

  APPEND lwa_fld TO lit_fld.


*"Perform read table from source and destination
  PERFORM z_read_tables USING l_table
                              lit_opt
                              lit_opt
                              lit_fld
                              p_scrfc
                              p_tcrfc
                     CHANGING lit_source
                              lit_target.

*-Get Domain Valie for GRPZE
  CALL FUNCTION 'DD_DOMVALUES_GET'
    EXPORTING
      domname        = 'GRPZE'
      text           = 'X'
      langu          = sy-langu
    TABLES
      dd07v_tab      = lit_dd07v
    EXCEPTIONS
      wrong_textflag = 1
      OTHERS         = 2.
  IF sy-subrc EQ 0.
    SORT lit_dd07v BY domvalue_l.
  ENDIF.

*-Get Routines Description
  SELECT *
        INTO TABLE lit_tfrmt
        FROM tfrmt
        WHERE spras EQ sy-langu.
  IF sy-subrc EQ 0.
    SORT lit_tfrmt BY grpze grpno.
  ENDIF.

*"Populate final table
  FREE: it_final_vofm.

  UNASSIGN <lfs_source>.

  LOOP AT lit_source
    ASSIGNING <lfs_source>.

    CLEAR: lwa_vofm.

    IF <lfs_source> IS ASSIGNED.

      MOVE: <lfs_source>+0(4) TO lwa_vofm-grpze,
            <lfs_source>+4(3) TO lwa_vofm-grpno,
            <lfs_source>+7(1) TO lwa_vofm-saktiv.
**--Get GRPZE Description
      READ TABLE lit_dd07v INTO lwa_dd07v WITH KEY domvalue_l = lwa_vofm-grpze
                                                   BINARY SEARCH.
      IF sy-subrc EQ 0.
        MOVE lwa_dd07v-ddtext TO lwa_vofm-grpsc.
      ENDIF.
**-Get Routine Desc
      READ TABLE lit_tfrmt INTO lwa_tfrmt WITH KEY grpze = lwa_vofm-grpze
                                                   grpno = lwa_vofm-grpno
                                                   BINARY SEARCH.
      IF sy-subrc EQ 0.
        MOVE : lwa_tfrmt-bezei TO lwa_vofm-bezei.
      ENDIF.

      MOVE: 'Exist'           TO lwa_vofm-source.
      MOVE: 'Does Not Exist'  TO lwa_vofm-target.

      APPEND lwa_vofm TO it_final_vofm.

    ENDIF."<lfs_source> IS ASSIGNED.

  ENDLOOP."lit_source ASSIGNING <lfs_source>.


  LOOP AT lit_target ASSIGNING <lfs_target>.

    CLEAR: lwa_vofm.

    IF <lfs_target> IS ASSIGNED.

      MOVE: <lfs_source>+0(4) TO lwa_vofm-grpze,
            <lfs_source>+4(3) TO lwa_vofm-grpno,
            <lfs_source>+7(1) TO lwa_vofm-taktiv.
**--Get GRPZE Description
      READ TABLE lit_dd07v INTO lwa_dd07v WITH KEY domvalue_l = lwa_vofm-grpze
                                                   BINARY SEARCH.
      IF sy-subrc EQ 0.
        MOVE lwa_dd07v-ddtext TO lwa_vofm-grpsc.
      ENDIF.
**-Get Routine Desc
      READ TABLE lit_tfrmt INTO lwa_tfrmt WITH KEY grpze = lwa_vofm-grpze
                                                   grpno = lwa_vofm-grpno
                                                   BINARY SEARCH.
      IF sy-subrc EQ 0.
        MOVE : lwa_tfrmt-bezei TO lwa_vofm-bezei.
      ENDIF.

      MOVE: 'Does Not Exist'      TO lwa_vofm-source.
      MOVE: 'Exist'               TO lwa_vofm-target.

      APPEND lwa_vofm TO it_final_vofm.

    ENDIF."<lfs_target> IS ASSIGNED.

  ENDLOOP."lit_target ASSIGNING <lfs_target>.


  SORT it_final_vofm
    BY grpze grpno source target.

  DELETE ADJACENT DUPLICATES FROM it_final_vofm COMPARING ALL FIELDS.

  IF it_final_vofm IS NOT INITIAL.
    PERFORM z_fieldcat USING 'GRPZE' 'Group ind.'     'IT_FINAL_VOFM' 18 'X' space.
    PERFORM z_fieldcat USING 'GRPSC' 'Description'    'IT_FINAL_VOFM' 18 'X' space .
    PERFORM z_fieldcat USING 'GRPNO' 'No. of the Routine'     'IT_FINAL_VOFM' 18 'X' space.
    PERFORM z_fieldcat USING 'BEZEI' 'Description'    'IT_FINAL_VOFM' 18 'X' space .
    PERFORM z_fieldcat USING 'SAKTIV' 'Activ Flag in Source'    'IT_FINAL_VOFM' 18 'X' space .
    PERFORM z_fieldcat USING 'TAKTIV' 'Activ Flag in Target'    'IT_FINAL_VOFM' 18 'X' space .
    PERFORM z_fieldcat USING 'SOURCE' 'Source sys'       'IT_FINAL_VOFM' 18 c_x space.
    PERFORM z_fieldcat USING 'TARGET' 'Target sys'       'IT_FINAL_VOFM' 18 c_x space.
    PERFORM z_output_alv TABLES it_final_vofm.
  ELSE.
    MESSAGE 'There are no differences in the VOFM Routines between the two systems' TYPE 'I'.

  ENDIF.

ENDFORM.                    " Z_COMPARE_VOFMROUTINES



