*&      Form  Z_COMPARE_BARCODES
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM z_compare_barcodes .

  DATA: l_table      TYPE dd02l-tabname,
        lit_opt      TYPE TABLE OF rfc_db_opt,
        lit_fld      TYPE TABLE OF rfc_db_fld,
        lit_source   TYPE TABLE OF tab512,
        lit_target   TYPE TABLE OF tab512,
        lwa_opt      TYPE rfc_db_opt,
        lwa_fld      TYPE rfc_db_fld,
        lwa_barc     TYPE t_final_barc,
        l_type       TYPE tdbtype,
        l_sourcetext TYPE scrtext_l,
        l_targettext TYPE scrtext_l.



  FIELD-SYMBOLS: <lfs_source> TYPE tab512,
                 <lfs_target> TYPE tab512.

  CLEAR: l_sourcetext,
         l_targettext.

*"Populate the table to be used
  MOVE: 'TFO05' TO l_table.

*"Populate the field list
  CLEAR: lwa_fld.

  MOVE: 'TDBARCODE'  TO  lwa_fld-fieldname,
        '8'         TO  lwa_fld-length   .

  APPEND  lwa_fld   TO lit_fld.

  CLEAR:  lwa_fld.

  MOVE: 'TDTEXT' TO  lwa_fld-fieldname,
        '30'   TO lwa_fld-length.

  APPEND lwa_fld TO lit_fld.


*"Perform read table from source and destination
  PERFORM z_read_tables USING l_table
                              lit_opt
                              lit_opt
                              lit_fld
                              p_scrfc
                              p_tcrfc
                     CHANGING lit_source
                              lit_target.


*"Populate final table
  FREE: it_final_barc.

  UNASSIGN <lfs_source>.

  LOOP AT lit_source
    ASSIGNING <lfs_source>.

    CLEAR: lwa_barc.

    IF <lfs_source> IS ASSIGNED.

      MOVE: <lfs_source>+0(8)  TO lwa_barc-tdbarcode,
            <lfs_source>+8(30) TO lwa_barc-tdtext.

      MOVE: 'Exist'      TO lwa_barc-source.
      MOVE: 'Not Exist'  TO lwa_barc-target.

      APPEND lwa_barc TO it_final_barc.

    ENDIF."<lfs_source> IS ASSIGNED.

  ENDLOOP."lit_source ASSIGNING <lfs_source>.


  LOOP AT lit_target ASSIGNING <lfs_target>.

    CLEAR: lwa_barc.

    IF <lfs_target> IS ASSIGNED.

      MOVE: <lfs_target>+0(8)  TO lwa_barc-tdbarcode,
            <lfs_target>+8(30) TO lwa_barc-tdtext.

      MOVE: 'Not Exist'        TO lwa_barc-source.
      MOVE: 'Exist'            TO lwa_barc-target.

      APPEND lwa_barc TO it_final_barc.

    ENDIF."<lfs_target> IS ASSIGNED.

  ENDLOOP."lit_target ASSIGNING <lfs_target>.


  SORT it_final_barc
    BY tdbarcode.

  DELETE ADJACENT DUPLICATES FROM it_final_barc COMPARING ALL FIELDS.

  IF it_final_barc IS NOT INITIAL.
    PERFORM z_fieldcat USING 'TDBARCODE' 'Barcode'     'IT_FINAL_BARC' 18 'X' space.
    PERFORM z_fieldcat USING 'TDTEXT'    'Description' 'IT_FINAL_BARC' 18 'X' space .
    PERFORM z_fieldcat USING 'SOURCE' 'Source sys'     'IT_FINAL_BARC' 18 c_x space.
    PERFORM z_fieldcat USING 'TARGET' 'Target sys'     'IT_FINAL_BARC' 18 c_x space.
    PERFORM z_output_alv TABLES it_final_barc.
  ELSE.
    MESSAGE 'There are no differences in the Barcodes between the two systems' TYPE 'I'.

  ENDIF.

ENDFORM.                    " Z_COMPARE_BARCODES
