        CALL FUNCTION 'RFC_PING' DESTINATION p_sprfc
          EXCEPTIONS
            system_failure        = 1  "MESSAGE rfc_mess
            communication_failure = 2  "MESSAGE rfc_mess
            OTHERS                = 99.
        IF sy-subrc NE 0.
          MESSAGE 'Ping failed to Source RFC Destination. Please check the connection' TYPE 'E'.
        ENDIF.
      ENDIF."sy-subrc NE 0.

    ENDIF."p_sprfc IS NOT INITIAL.

    IF p_tprfc IS NOT INITIAL.

*      TRANSLATE p_tprfc TO UPPER CASE.

      CLEAR: l_rfc.

      SELECT SINGLE rfcdest
        FROM rfcdes
        INTO l_rfc
       WHERE rfcdest EQ p_tprfc AND rfctype EQ c_abap_conn.
      IF sy-subrc NE 0.
        MESSAGE 'No such RFC Destination exists. Please enter correct Target RFC Destination' TYPE 'E'.
      ELSE.
        CALL FUNCTION 'RFC_PING' DESTINATION p_tprfc
          EXCEPTIONS
            system_failure        = 1  "MESSAGE rfc_mess
            communication_failure = 2  "MESSAGE rfc_mess
            OTHERS                = 99.
        IF sy-subrc NE 0.
          MESSAGE 'Ping failed to Target RFC Destination. Please check the connection' TYPE 'E'.
        ENDIF.

      ENDIF."sy-subrc NE 0.

    ENDIF."p_tprfc IS NOT INITIAL.


    IF p_psprfc IS NOT INITIAL.

*      TRANSLATE p_psprfc TO UPPER CASE.

      CLEAR: l_parnum.

      SELECT SINGLE parnum
        FROM edpp1
        INTO l_parnum
       WHERE parnum EQ p_psprfc
         AND partyp EQ c_ls.
      IF sy-subrc NE 0.
        MESSAGE 'No such PI Source Logical System exists. Please enter correct PI Source Logical System' TYPE 'E'.
      ENDIF."sy-subrc NE 0.

    ENDIF."p_psprfc IS NOT INITIAL.

    IF p_ptprfc IS NOT INITIAL.

*      TRANSLATE p_ptprfc TO UPPER CASE.

      CLEAR: l_parnum.

      SELECT SINGLE parnum
        FROM edpp1
        INTO l_parnum
       WHERE parnum EQ p_psprfc
         AND partyp EQ c_ls.
      IF sy-subrc NE 0.
        MESSAGE 'No such PI Logical System exists. Please enter correct PI Target Logical System' TYPE 'E'.
      ENDIF."sy-subrc NE 0.

    ENDIF."p_ptprfc IS NOT INITIAL.

  ENDIF."p_pprf IS NOT INITIAL.

ENDFORM.                    "Z_validate_partner


*&---------------------------------------------------------------------*
*& FORM        - COMPARE_TABLE
*& INPUT       - Table Name
*&               RFC Destination
*& DESCRIPTION - This routine compares the table between current system
*&               and target rfc destination
*&---------------------------------------------------------------------*

FORM z_compare_table.

  CONSTANTS: lc_entry  TYPE c LENGTH 10 VALUE 'LRMSPQ',
             lc_c      TYPE c LENGTH 1 VALUE 'C',
             lc_online TYPE c LENGTH 6 VALUE 'ONLINE',
             lc_e      TYPE dd26e-enqmode VALUE 'E'.

  TYPES: BEGIN OF lt_dyn300_type,
           view                    TYPE dd02l-tabname,
           rfc_dest                TYPE rfcdes-rfcdest,
           sel                     TYPE c LENGTH 1,
           batch                   TYPE c LENGTH 1,
           adjust                  TYPE c LENGTH 1,
           only_diffs              TYPE c LENGTH 1,
           adj_000                 TYPE c LENGTH 1,
           mode                    TYPE c LENGTH 1,
           calltype                TYPE c LENGTH 6,
           sap_system              TYPE c LENGTH 1,
           no_first_pbo            TYPE c LENGTH 1,
           display_entry_types(10) TYPE c,
           restrict                TYPE c LENGTH 1,
           msg                     TYPE cmpwl_s_msg_type,
           wlid                    TYPE cmpwlh-wlid,
           cmp_tab                 TYPE c LENGTH 1,
         END OF lt_dyn300_type.

  DATA: lwa_dyn300 TYPE lt_dyn300_type,
        l_tab      TYPE rstable-tabname,
        l_tab_view TYPE dd02l-tabname.

* Get the name of the parameter

  MOVE: p_tabnm TO l_tab.
  MOVE: p_tabnm TO l_tab_view.

  CONDENSE: l_tab, l_tab_view.

** Enqueue Table

  CALL FUNCTION 'ENQUEUE_E_TABLEE'
    EXPORTING
      mode_rstable   = lc_e
      tabname        = l_tab
    EXCEPTIONS
      foreign_lock   = 1
      system_failure = 2
      OTHERS         = 3.

  IF sy-subrc <> 0.
    MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
        WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    RETURN.
  ENDIF.

** Get Differences Report

  lwa_dyn300-display_entry_types = lc_entry.
  lwa_dyn300-mode = lc_c.
  lwa_dyn300-adj_000 = space.
  lwa_dyn300-sel = space.

  lwa_dyn300-cmp_tab = space.
  lwa_dyn300-batch = space.
  lwa_dyn300-restrict = space.
  lwa_dyn300-wlid = space.

  lwa_dyn300-calltype = lc_online.


  SUBMIT rscmpadj AND RETURN
              WITH view = l_tab_view
              WITH rfc_dest = p_rrfc
              WITH sel = lwa_dyn300-sel
              WITH adj_000 = lwa_dyn300-adj_000
              WITH mode = lwa_dyn300-mode
              WITH cmp_tab = lwa_dyn300-cmp_tab
              WITH calltype = lwa_dyn300-calltype
              WITH sel_type = 6
              WITH dis_filt = lwa_dyn300-display_entry_types
              WITH batch = lwa_dyn300-batch
              WITH stru_pop = lwa_dyn300-restrict
              WITH wlid = lwa_dyn300-wlid
              WITH fexpt = space.

** Dequeque Table

  CALL FUNCTION 'DEQUEUE_E_TABLEE'
    EXPORTING
      mode_rstable = lc_e
      tabname      = lwa_dyn300-view.

ENDFORM.                                                 "z_compare_table


