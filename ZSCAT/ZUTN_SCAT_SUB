  DESCRIBE TABLE lit_data_p LINES l_lin_p.

  SORT lit_data_p BY wa.

  IF l_lin_q GT l_lin_p.

    LOOP AT lit_data_q INTO lwa_data_q.

      READ TABLE lit_data_p
      WITH KEY wa = lwa_data_q-wa
      TRANSPORTING NO FIELDS
      BINARY SEARCH.

      IF sy-subrc EQ 0.
        CONTINUE.
      ELSE.

