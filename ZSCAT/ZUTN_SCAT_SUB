FORM z_unlck_std_txt.

  CONSTANTS: lc_object TYPE trobjtype VALUE 'TEXT'.

  TYPES: BEGIN OF lt_stdname,
           stdname TYPE char70,
         END OF lt_stdname.

  FIELD-SYMBOLS: <fs_stxh>     TYPE t_stxh,
                 <fs_stx_e071> TYPE t_stx_e071,
                 <fs_stxh_fet> TYPE t_stxh_fet,
                 <fs_stdname>  TYPE lt_stdname.

  DATA: lit_stdname TYPE TABLE OF lt_stdname.

  DATA: lwa_stxh_fet TYPE t_stxh_fet,
        l_text       TYPE char20,
        l_std        TYPE char20,
        l_stname     TYPE char20,
        l_sec        TYPE char20.


  CLEAR it_stxh.

  SELECT tdobject tdname tdid tdspras tdtitle tdfuser
    FROM stxh
    INTO TABLE it_stxh
   WHERE tdobject EQ c_text
     AND ( tdname LIKE c_zobjname OR tdname LIKE c_yobjname )
     AND tdid EQ c_st
     AND tdfuser NE c_sap.

  IF sy-subrc EQ 0.

    CLEAR: it_stxh_fet.

    LOOP AT it_stxh ASSIGNING <fs_stxh>.

      IF <fs_stxh> IS ASSIGNED.

        MOVE: <fs_stxh>-tdobject TO lwa_stxh_fet-tdobject,
              <fs_stxh>-tdname   TO lwa_stxh_fet-tdname,
              <fs_stxh>-tdid     TO lwa_stxh_fet-tdid,
              <fs_stxh>-tdspras  TO lwa_stxh_fet-tdspras,
              <fs_stxh>-tdtitle  TO lwa_stxh_fet-tdtitle,
              <fs_stxh>-tdfuser  TO lwa_stxh_fet-tdfuser.

        CONCATENATE: lc_object ',' <fs_stxh>-tdname ',' <fs_stxh>-tdid ',' <fs_stxh>-tdspras INTO lwa_stxh_fet-objname.

        APPEND lwa_stxh_fet TO it_stxh_fet.
        CLEAR: lwa_stxh_fet.

      ENDIF."<fs_unlck_sttx> IS ASSIGNED

    ENDLOOP."it_unlck_sttx ASSIGNING <fs_unlck_sttx>.

  ENDIF."sy-subrc EQ 0.

  CLEAR it_stx_e071.

  IF it_stxh_fet IS NOT INITIAL.

    SELECT trkorr obj_name
      FROM e071
      INTO TABLE it_stx_e071
      FOR ALL ENTRIES IN it_stxh_fet
      WHERE object EQ lc_object AND
            obj_name EQ it_stxh_fet-objname.

    IF sy-subrc EQ 0.

      CLEAR it_unlck_sttx.

      SORT it_stx_e071 BY obj_name.

      LOOP AT it_stxh_fet ASSIGNING <fs_stxh_fet>.

        IF <fs_stxh_fet> IS ASSIGNED.

          READ TABLE it_stx_e071 ASSIGNING <fs_stx_e071>
          WITH KEY obj_name = <fs_stxh_fet>-objname
          BINARY SEARCH.

          IF sy-subrc NE 0.

            CLEAR: wa_unlck_sttx.

            MOVE: <fs_stxh_fet>-tdobject TO wa_unlck_sttx-tdobject,
                  <fs_stxh_fet>-tdname   TO wa_unlck_sttx-tdname,
                  <fs_stxh_fet>-tdspras  TO wa_unlck_sttx-tdspras,
                  <fs_stxh_fet>-tdtitle  TO wa_unlck_sttx-tdtitle,
                  <fs_stxh_fet>-tdfuser  TO wa_unlck_sttx-tdfuser.

            APPEND wa_unlck_sttx TO it_unlck_sttx.

          ENDIF. "sy-subrc EQ 0

        ENDIF."<fs_stxh> IS ASSIGNED.

      ENDLOOP."AT it_stxh ASSIGNING <fs_stxh>.

    ENDIF."sy-subrc EQ 0

  ENDIF. "it_stxh_fet IS NOT INITIAL

  IF it_unlck_sttx IS INITIAL.
    MESSAGE 'There are no unlocked standard texts' TYPE 'I'.
  ELSE.

    SORT it_unlck_sttx BY tdname tdtitle tdspras tdfuser.

    CLEAR it_fieldcat.

    PERFORM z_fieldcat USING 'TDNAME' 'Text Name' 'IT_UNLCK_STTX' 18 c_x space.
    PERFORM z_fieldcat USING 'TDTITLE' 'Title' 'IT_UNLCK_STTX' 18 c_x space.
    PERFORM z_fieldcat USING 'TDSPRAS' 'Language' 'IT_UNLCK_STTX' 18 c_x space.
    PERFORM z_fieldcat USING 'TDFUSER' 'UserName' 'IT_UNLCK_STTX' 18 c_x space.

    CLEAR wa_sort.
    CLEAR it_sort.

    MOVE: '1'                TO wa_sort-spos,
          'TDNAME '          TO wa_sort-fieldname,
          'IT_UNLCK_STTX'    TO wa_sort-tabname.

    APPEND wa_sort TO it_sort.


    PERFORM z_output_alv TABLES it_unlck_sttx.

  ENDIF."it_unlck_sttx IS INITIAL.

ENDFORM.  "z_unlck_std_txt.
