FORM z_tmp_list.

  FIELD-SYMBOLS: <fs_tmp_object> TYPE t_tmp_object,
                 <fs_obtab>      TYPE ko100.
  DATA: lwa_tmp TYPE t_tmp.

  CLEAR it_tmp_object.

  SELECT pgmid
         object
         obj_name
         author
         devclass
    FROM tadir
    INTO TABLE it_tmp_object
    WHERE ( obj_name LIKE c_zobjname
         OR obj_name LIKE c_yobjname ) AND
            devclass EQ c_tmp AND
            author   NE c_sap AND
            delflag  NE c_x.

  IF sy-subrc NE 0 AND it_tmp_object IS INITIAL.

    MESSAGE 'There are no objects in $TMP' TYPE 'I'.

  ELSEIF it_tmp_object IS NOT INITIAL.

    CLEAR: it_tmp.

    DELETE it_tmp_object WHERE pgmid = 'LIMU' AND object = 'COMM'.

    LOOP AT it_tmp_object ASSIGNING <fs_tmp_object>.

      CLEAR: lwa_tmp.

      IF <fs_tmp_object> IS ASSIGNED.

        MOVE: <fs_tmp_object>-obj_name TO lwa_tmp-obj_name,
              <fs_tmp_object>-author   TO lwa_tmp-author.

        SORT it_obtab BY pgmid object.

        READ TABLE it_obtab ASSIGNING <fs_obtab>
        WITH KEY pgmid  = <fs_tmp_object>-pgmid
                 object = <fs_tmp_object>-object BINARY SEARCH.

        IF sy-subrc EQ 0.

          IF <fs_obtab> IS ASSIGNED.
            MOVE: <fs_obtab>-text TO lwa_tmp-obj_desc.
          ENDIF."<fs_obtab> IS ASSIGNED.

        ENDIF."sy-subrc EQ 0.

      ENDIF. "<fs_tmp_object> IS ASSIGNED.

      APPEND lwa_tmp TO it_tmp.

    ENDLOOP."it_tmp_object ASSIGNING <fs_tmp_object>.

    CLEAR it_fieldcat.

    PERFORM z_fieldcat USING 'OBJ_NAME' 'Object Name'        'IT_TMP' 18 c_x space.
    PERFORM z_fieldcat USING 'OBJ_DESC' 'Object Description' 'IT_TMP' 18 c_x space.
    PERFORM z_fieldcat USING 'AUTHOR'   'Author'             'IT_TMP' 18 c_x space.

    PERFORM z_output_alv TABLES it_tmp.

  ENDIF."sy-subrc NE 0 AND it_tmp_object IS INITIAL

ENDFORM.                    " Z_TMP_LIST


