FORM screen  USING p_g_group1.

  IF p_g_group1 IS NOT INITIAL.

    LOOP AT SCREEN.
      IF screen-group1 IS NOT INITIAL.
*RFC Connection Test
        IF p_rfct = abap_true.
          IF screen-group1 EQ p_g_group1.
            screen-active = 1.
            MODIFY SCREEN.
          ELSEIF screen-group1 EQ 'OPT'.
            screen-active = 1.
            MODIFY SCREEN.
          ELSE.
            screen-active = 0.
            MODIFY SCREEN.
          ENDIF.
*Comparison
        ELSEIF p_comp = abap_true.
          IF screen-group1 EQ p_g_group1.
            screen-active = 1.
            MODIFY SCREEN.
          ELSEIF screen-group1 EQ 'COM' AND p_gen = abap_true.
            screen-active = 1.
            MODIFY SCREEN.
          ELSEIF screen-group1 EQ 'INT' AND p_int = abap_true AND p_cust NE abap_true.
            screen-active = 1.
            MODIFY SCREEN.
          ELSEIF screen-group1 EQ 'OPT'.
            screen-active = 1.
            MODIFY SCREEN.
          ELSEIF screen-group1 EQ 'CMN'.
            screen-active = 1.
            MODIFY SCREEN.
          ELSE.
            screen-active = 0.
            MODIFY SCREEN.
          ENDIF.
*          IF screen-group1 EQ p_g_group1.
*            screen-active = 1.
*            MODIFY SCREEN.
*          ELSEIF screen-group1 EQ 'COM'.
*            screen-active = 1.
*            MODIFY SCREEN.
*          ELSEIF screen-group1 EQ 'OPT'.
*            screen-active = 1.
*            MODIFY SCREEN.
*          ELSE.
*            screen-active = 0.
*            MODIFY SCREEN.
*          ENDIF.
*Transport Utilities
        ELSEIF p_util = abap_true AND p_trpt IS NOT INITIAL.

          IF screen-group1 EQ p_g_group1.
            screen-active = 1.
            MODIFY SCREEN.
          ELSEIF screen-group1 EQ 'DEP'.
            screen-active = 1.
            MODIFY SCREEN.
          ELSEIF screen-group1 EQ 'TUL'.
            screen-active = 1.
            MODIFY SCREEN.
          ELSEIF screen-group1 EQ 'OPT'.
            screen-active = 1.
            MODIFY SCREEN.
          ELSE.
            screen-active = 0.
            MODIFY SCREEN.
          ENDIF.
        ELSEIF p_util = abap_true AND p_objt IS NOT INITIAL.

          IF screen-group1 EQ p_g_group1.
            screen-active = 1.
            MODIFY SCREEN.
          ELSEIF screen-group1 EQ 'DEP'.
            screen-active = 1.
            MODIFY SCREEN.
          ELSEIF screen-group1 EQ 'TUL'.
            screen-active = 1.
            MODIFY SCREEN.
          ELSEIF screen-group1 EQ 'OPT'.
            screen-active = 1.
            MODIFY SCREEN.
          ELSE.
            screen-active = 0.
            MODIFY SCREEN.
          ENDIF.
* Start of BSINGH-14-JAN-2017(+)
* Source Code Comparison Utilities
        ELSEIF p_cchk = abap_true.
          IF screen-group1 EQ p_g_group1.
            screen-active = 1.
            MODIFY SCREEN.
          ELSEIF screen-group1 EQ 'CCK'.
            screen-active = 1.
            MODIFY SCREEN.
          ELSEIF screen-group1 EQ 'OPT'.
            screen-active = 1.
            MODIFY SCREEN.
          ELSE.
            screen-active = 0.
            MODIFY SCREEN.
          ENDIF.
* End of BSINGH-14-JAN-2017(+)
*----------------------------------------------------
* Other Utilities
*----------------------------------------------------

        ELSEIF p_othr = abap_true.

          IF screen-group1 EQ p_g_group1.
            screen-active = 1.
            MODIFY SCREEN.
          ELSEIF screen-group1 EQ 'OPT'.
            screen-active = 1.
            MODIFY SCREEN.
          ELSE.
            screen-active = 0.
            MODIFY SCREEN.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDLOOP.
  ENDIF.

