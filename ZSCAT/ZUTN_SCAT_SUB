FORM z_user_command USING fp_ucomm TYPE sy-ucomm
                          fp_field TYPE slis_selfield.

  CONSTANTS: lc_trkorr      TYPE slis_selfield-fieldname VALUE 'TRKORR',
             lc_parent      TYPE slis_selfield-fieldname VALUE 'PARENT',
             lc_strkorr     TYPE slis_selfield-fieldname VALUE 'STRKORR',
*            Start of BSINGH-14-JAN-2017(+)
             lc_conflict    TYPE slis_selfield-fieldname VALUE 'CONFLICT',
             lc_conflict_tx TYPE slis_selfield-fieldname VALUE 'TX_CONFLICT',
             lc_disp_action TYPE seu_action VALUE 'DISPLAY',
             lc_i           TYPE char1 VALUE 'I',
             lc_r           TYPE char1 VALUE 'R',
             lc_s           TYPE char1 VALUE 'S'.

  TYPES: BEGIN OF lt_text_tab,
           type  TYPE char40,
           key   TYPE char3,
           lang  TYPE spras,
           entry TYPE char40,
         END OF lt_text_tab.

* End of BSINGH-14-JAN-2017(+)

  DATA: l_transport TYPE trkorr,
*     Start of BSINGH-14-JAN-2017(+)

        l_objname   TYPE progdir-name,
        l_objname_v TYPE vrsd-objname.

  DATA: lit_rep_left   TYPE TABLE OF abaptxt255,
        lit_rep_rt     TYPE TABLE OF abaptxt255,
        lit_trdir_left TYPE TABLE OF trdir,
        lit_trdir_rt   TYPE TABLE OF trdir,
        lit_repot_src  TYPE TABLE OF textpoolt,
        lit_rep_s      TYPE TABLE OF textpoolt,
        lit_rep_t      TYPE TABLE OF textpoolt,
        lit_repot_tgt  TYPE TABLE OF textpoolt,
        lit_outtab     TYPE TABLE OF lt_text_tab,
        lit_text_tab   TYPE TABLE OF lt_text_tab,
        lit_fldcat     TYPE slis_t_fieldcat_alv,
        lwa_text_tab   TYPE lt_text_tab,
        lwa_fldcat     TYPE slis_fieldcat_alv.

  FIELD-SYMBOLS: <lfs_conop> TYPE t_conf_output,
                 <lfs_rep_s> TYPE textpoolt,
                 <lfs_rep_t> TYPE textpoolt.
*     End of BSINGH-14-JAN-2017(+)

  MOVE: fp_field-value TO l_transport.

  CASE fp_field-fieldname.

*   To show SE09 screen once the transport # is clicked

    WHEN lc_trkorr OR lc_parent OR lc_strkorr.
      CALL FUNCTION 'CNV_CDMC_CTS_TRANSPORT_DISPLAY'
        EXPORTING
          trkorr            = l_transport
        EXCEPTIONS
          not_exist         = 1
          invalid_user_type = 2
          OTHERS            = 3.
      IF sy-subrc NE 0.
        CASE sy-subrc.
          WHEN 2.
            MESSAGE 'The logon user should be of the type - Dialog' TYPE 'I'.
          WHEN 1.
            MESSAGE 'The transport number is incorrect' TYPE 'I'.
          WHEN OTHERS.
            MESSAGE 'Error in display of transport details' TYPE 'I'.
        ENDCASE.
        RETURN.
      ENDIF.

*   Start of BSINGH-14-JAN-2017(+)

    WHEN lc_conflict.

      READ TABLE it_conop ASSIGNING <lfs_conop> INDEX fp_field-tabindex.

      IF sy-subrc EQ 0 AND <lfs_conop>-conflict EQ 'Differences exist'.

        IF p_prog IS NOT INITIAL.

          MOVE: <lfs_conop>-prgname    TO wa_infoln1a-objname,
                <lfs_conop>-prgname    TO wa_infoln2a-objname,
                <lfs_conop>-prgname    TO l_objname.

          MOVE: <lfs_conop>-sourcetr   TO wa_infoln1b-korrnum,
                <lfs_conop>-sourcedt   TO wa_infoln1b-datum,
                <lfs_conop>-sourceauth TO wa_infoln1b-author,
                <lfs_conop>-targettr   TO wa_infoln2b-korrnum,
