FORM z_get_tr_by_obj.

  TYPES: BEGIN OF lt_trkorr,
           trkorr TYPE e070-trkorr,
         END OF lt_trkorr.

  DATA: lit_options TYPE TABLE OF rfc_db_opt,
        lit_fields  TYPE TABLE OF rfc_db_fld,
        lit_data_q  TYPE TABLE OF tab512,
        lwa_data_q  TYPE tab512,
        lit_data_p  TYPE TABLE OF tab512,
        lit_tadir   TYPE TABLE OF t_tadir_tr,
        lit_spop    TYPE TABLE OF spopli,
        lit_func    TYPE TABLE OF t_tfdir,
        lit_class   TYPE TABLE OF t_class,
        lwa_spop    TYPE spopli,
        lwa_fields  TYPE rfc_db_fld,
        lwa_options TYPE rfc_db_opt,
        l_lin_q     TYPE i,
        l_lin_p     TYPE i,
        lit_trkorr  TYPE TABLE OF lt_trkorr,
        lwa_trkorr  TYPE lt_trkorr,
        l_obj_name  TYPE c LENGTH 40,
        l_answer    TYPE santw,
        l_index     TYPE sy-index.

  CONSTANTS: lc_ans TYPE santw VALUE 'A',
             lc_hyp TYPE c VALUE '-'.

  FIELD-SYMBOLS: <fs_tadir>   TYPE t_tadir_tr,
                 <fs_func>    TYPE t_tfdir,
                 <fs_class>   TYPE t_class,
                 <lfs_data_q> TYPE tab512.

  CLEAR:   lit_fields,
           lit_data_q,
           lit_data_p.
  CLEAR:   lwa_fields.

  IF p_obj IS NOT INITIAL.

    TRANSLATE p_obj TO UPPER CASE.

    CONCATENATE c_per p_obj c_per INTO l_obj_name.

    CLEAR lit_tadir.
    SELECT object obj_name devclass FROM tadir
      INTO TABLE lit_tadir
      WHERE obj_name LIKE l_obj_name.

    IF sy-subrc NE 0.

      CLEAR lit_func.
      SELECT funcname pname FROM tfdir
      INTO TABLE lit_func
      WHERE funcname LIKE l_obj_name.

      IF sy-subrc NE 0.

        CLEAR lit_class.

        SELECT classname methodindx methodname
         FROM tmdir
         INTO TABLE lit_class
         WHERE classname LIKE l_obj_name.
        IF sy-subrc NE 0.

          CLEAR lit_class.

          SELECT classname methodindx methodname
           FROM tmdir
           INTO TABLE lit_class
           WHERE methodname LIKE l_obj_name.

          IF sy-subrc NE 0.

            MESSAGE 'No Objects found with such a name' TYPE 'I'.
            LEAVE LIST-PROCESSING.

          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.


    LOOP AT lit_tadir ASSIGNING <fs_tadir>.

      IF <fs_tadir> IS ASSIGNED.

        CLEAR: lwa_spop.

        CONCATENATE <fs_tadir>-object lc_hyp <fs_tadir>-obj_name INTO lwa_spop-varoption.

        APPEND lwa_spop TO lit_spop.

      ENDIF. "<fs_tadir> IS ASSIGNED

    ENDLOOP. "lit_tadir ASSIGNING <fs_tadir>.

    LOOP AT lit_func ASSIGNING <fs_func>.

      IF <fs_func> IS ASSIGNED.

        CLEAR: lwa_spop.

        CONCATENATE 'FUNC' lc_hyp <fs_func>-funcname INTO lwa_spop-varoption.

        APPEND lwa_spop TO lit_spop.

      ENDIF. "fs_func> IS ASSIGNED.

    ENDLOOP. "lit_func ASSIGNING <fs_func>.

    LOOP AT lit_class ASSIGNING <fs_class>.

      IF <fs_class> IS ASSIGNED.

        CLEAR: lwa_spop.

        CONCATENATE <fs_class>-classname lc_hyp <fs_class>-methodname INTO lwa_spop-varoption.

        APPEND lwa_spop TO lit_spop.

      ENDIF. "<fs_class> IS ASSIGNED.

    ENDLOOP. "lit_class ASSIGNING <fs_class>.

    IF lines( lit_spop ) GT 1.

      CALL FUNCTION 'POPUP_TO_DECIDE_LIST'
        EXPORTING
          textline1          = 'Choose the object from the below list'
          titel              = 'Object List'
        IMPORTING
          answer             = l_answer
        TABLES
          t_spopli           = lit_spop
        EXCEPTIONS
          not_enough_answers = 1
          too_much_answers   = 2
          too_much_marks     = 3
          OTHERS             = 4.
      IF sy-subrc NE 0.
        CLEAR: l_answer.
      ENDIF.

      IF l_answer IS NOT INITIAL.

        MOVE: l_answer TO l_index.

        IF lit_tadir IS NOT INITIAL.

          READ TABLE lit_tadir ASSIGNING <fs_tadir> INDEX l_index.
          IF sy-subrc EQ 0 AND <fs_tadir> IS ASSIGNED.
            l_obj_name = <fs_tadir>-obj_name.
          ENDIF."sy-subrc EQ 0 AND <fs_tadir> IS ASSIGNED

        ELSEIF lit_func IS NOT INITIAL.
          READ TABLE lit_func ASSIGNING <fs_func> INDEX l_index.
          IF sy-subrc EQ 0 AND <fs_func> IS ASSIGNED.
            l_obj_name = <fs_func>-funcname.
          ENDIF."sy-subrc EQ 0 AND <fs_tadir> IS ASSIGNED

        ELSEIF lit_class IS NOT INITIAL.
          READ TABLE lit_class ASSIGNING <fs_class> INDEX l_index.
          IF sy-subrc EQ 0 AND <fs_class> IS ASSIGNED.
            l_obj_name = <fs_class>-methodname.
          ENDIF."sy-subrc EQ 0 AND <fs_tadir> IS ASSIGNED
        ENDIF."lit_tadir IS NOT INITIAL.

      ENDIF. "l_answer IS NOT INITIAL.

    ENDIF. "lines( lit_spop ) GT 1.


*   Populate fields to be fetched

    MOVE: 'TRKORR' TO lwa_fields-fieldname, " Transport Number
          20       TO lwa_fields-length.

    APPEND lwa_fields TO lit_fields.
    CLEAR: lwa_fields.


*   Populate the where clause

    CLEAR: lit_options.
    CLEAR: lwa_options.

    CONCATENATE 'OBJ_NAME LIKE ''' c_per p_obj c_per c_comma ' AND STRKORR EQ space' INTO lwa_options-text.
    APPEND lwa_options TO lit_options.
    CLEAR: lwa_options.


*   Get data from Quality

    CALL FUNCTION 'RFC_READ_TABLE' DESTINATION p_qua
      EXPORTING
        query_table          = 'V_E071EU'
      TABLES
        options              = lit_options
        fields               = lit_fields
        data                 = lit_data_q
      EXCEPTIONS
        table_not_available  = 1
        table_without_data   = 2
        option_not_valid     = 3
        field_not_valid      = 4
        not_authorized       = 5
        data_buffer_exceeded = 6
        OTHERS               = 7.
    IF sy-subrc <> 0.
      MESSAGE 'Cannot read data from Quality' TYPE 'E'.
      RETURN.
    ENDIF.

*   Get data from Production

    CALL FUNCTION 'RFC_READ_TABLE' DESTINATION p_prd
      EXPORTING
        query_table          = 'V_E071EU'
      TABLES
        options              = lit_options
        fields               = lit_fields
        data                 = lit_data_p
      EXCEPTIONS
        table_not_available  = 1
        table_without_data   = 2
        option_not_valid     = 3
        field_not_valid      = 4
        not_authorized       = 5
        data_buffer_exceeded = 6
        OTHERS               = 7.
    IF sy-subrc <> 0.
      MESSAGE 'Cannot read data from Production' TYPE 'E'.
      RETURN.
    ENDIF.

  ENDIF." p_obj IS NOT INITIAL.

  CLEAR: l_lin_p, l_lin_q, lwa_data_q.

