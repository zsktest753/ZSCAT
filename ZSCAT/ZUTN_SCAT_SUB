*&---------------------------------------------------------------------*
*&      Form  z_read_tables
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->PV_TABLE     text
*      -->PIT_OPTIONS  text
*      -->PIT_FIELDS   text
*      -->PIT_SOURCE   text
*      -->PIT_TARGET   text
*----------------------------------------------------------------------*

FORM z_read_tables USING fp_v_table       TYPE dd02l-tabname
                         fp_it_options    TYPE t_options
                         fp_it_options_t  TYPE t_options
                         fp_it_fields     TYPE t_fields
                         fp_p_srfc        TYPE rfcdes-rfcdest
                         fp_p_trfc        TYPE rfcdes-rfcdest
                CHANGING fp_it_source     TYPE t_data
                         fp_it_target     TYPE t_data.

  DATA: lit_data_s TYPE TABLE OF tab512,
        lit_data_t TYPE TABLE OF tab512,
        lit_source TYPE TABLE OF tab512,
        lit_target TYPE TABLE OF tab512.

  DATA: lwa_data_t TYPE tab512.

  FIELD-SYMBOLS: <lfs_data_s> TYPE tab512.

* Read from source destination

  CLEAR: lit_data_s.

  CALL FUNCTION 'RFC_READ_TABLE' DESTINATION fp_p_srfc
    EXPORTING
      query_table          = fp_v_table
    TABLES
      options              = fp_it_options
      fields               = fp_it_fields
      data                 = lit_data_s
    EXCEPTIONS
      table_not_available  = 1
      table_without_data   = 2
      option_not_valid     = 3
      field_not_valid      = 4
      not_authorized       = 5
      data_buffer_exceeded = 6
      OTHERS               = 7.
  IF sy-subrc NE 0.
    CLEAR: lit_data_s.
    MESSAGE 'Cannot read data from Source System' TYPE 'E'.
  ENDIF.

  DELETE ADJACENT DUPLICATES FROM lit_data_s COMPARING ALL FIELDS.

*  Read from target destination

  CLEAR lit_data_t.

  CALL FUNCTION 'RFC_READ_TABLE' DESTINATION fp_p_trfc
    EXPORTING
      query_table          = fp_v_table
    TABLES
      options              = fp_it_options_t
      fields               = fp_it_fields
      data                 = lit_data_t
    EXCEPTIONS
      table_not_available  = 1
      table_without_data   = 2
      option_not_valid     = 3
      field_not_valid      = 4
      not_authorized       = 5
      data_buffer_exceeded = 6
      OTHERS               = 7.
  IF sy-subrc <> 0.
    CLEAR: lit_data_t.
    MESSAGE 'Cannot read data from Target System' TYPE 'E'.
  ENDIF.

  DELETE ADJACENT DUPLICATES FROM lit_data_t COMPARING ALL FIELDS.
  CLEAR:   lit_source,
           lit_target.

  lit_source = lit_data_s.
  lit_target = lit_data_t.

  LOOP AT lit_data_s
    ASSIGNING <lfs_data_s>.

    IF <lfs_data_s> IS ASSIGNED.

      READ TABLE lit_data_t
      INTO lwa_data_t
      FROM <lfs_data_s>.

      IF sy-subrc EQ 0.

        DELETE TABLE lit_source FROM <lfs_data_s>.
        DELETE TABLE lit_target FROM <lfs_data_s>.

      ENDIF. "sy-subrc EQ 0.

    ENDIF. "<fs_data_s> IS ASSIGNED.

  ENDLOOP. "lit_data_s ASSIGNING <fs_data_s>.

  fp_it_source = lit_source.
  fp_it_target = lit_target.

ENDFORM.                    "z_read_tables

