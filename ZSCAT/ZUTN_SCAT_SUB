*       text
*----------------------------------------------------------------------*

FORM z_compare_graphics.

  CONSTANTS: lc_y      TYPE c LENGTH 2 VALUE 'Y%',
             lc_z      TYPE c LENGTH 2 VALUE 'Z%',
             lc_bcol   TYPE tdbtype VALUE 'BCOL',
             lc_bmon   TYPE tdbtype VALUE 'BMON',
             lc_color  TYPE c LENGTH 20 VALUE 'Color Bitmap',
             lc_bw     TYPE c LENGTH 20 VALUE 'B/W Bitmap',
             lc_kronos TYPE c LENGTH 8 VALUE '%KRONOS%'.

  DATA: l_table      TYPE dd02l-tabname,
        lit_opt      TYPE TABLE OF rfc_db_opt,
        lit_fld      TYPE TABLE OF rfc_db_fld,
        lit_source   TYPE TABLE OF tab512,
        lit_target   TYPE TABLE OF tab512,
        lwa_opt      TYPE rfc_db_opt,
        lwa_fld      TYPE rfc_db_fld,
        l_type       TYPE tdbtype,
        l_sourcetext TYPE scrtext_l,
        l_targettext TYPE scrtext_l.

  FIELD-SYMBOLS: <lfs_source> TYPE tab512,
                 <lfs_target> TYPE tab512.

  CLEAR: l_sourcetext,
         l_targettext.

* Populate the table to be used

  MOVE: 'STXBITMAPS' TO l_table.

* Populate the field list

  CLEAR: lwa_fld.
  MOVE: 'TDNAME' TO  lwa_fld-fieldname,
        '70'   TO  lwa_fld-length.
  APPEND  lwa_fld TO lit_fld.

  CLEAR:  lwa_fld.
  MOVE: 'TDBTYPE' TO  lwa_fld-fieldname,
        '4'   TO lwa_fld-length.
  APPEND lwa_fld TO lit_fld.

* Populate the condition for data fetching

  CLEAR: lwa_opt.

  CONCATENATE 'TDNAME LIKE ''' c_comma lc_kronos c_comma ' OR TDNAME LIKE ''' c_comma lc_kronos c_comma INTO lwa_opt-text.
  APPEND lwa_opt TO lit_opt.
  CLEAR: lwa_opt.

* Perform read table from source and destination

  PERFORM z_read_tables USING l_table lit_opt lit_opt lit_fld p_scrfc p_tcrfc CHANGING lit_source lit_target.

* Populate final table

  CLEAR: it_final_gra.

  LOOP AT lit_source
    ASSIGNING <lfs_source>.

    CLEAR: wa_final_gra.

    IF <lfs_source> IS ASSIGNED.

      MOVE: <lfs_source>+0(69)  TO wa_final_gra-graphic,
            <lfs_source>+70(4)  TO l_type.

      IF l_type EQ lc_bcol.
        MOVE: lc_color TO wa_final_gra-type.
      ELSEIF l_type EQ lc_bmon.
        MOVE: lc_bw TO wa_final_gra-type.
      ENDIF.

      MOVE: 'Yes' TO wa_final_gra-source.
      MOVE: 'No' TO wa_final_gra-target.

      APPEND wa_final_gra TO it_final_gra.

    ENDIF."<lfs_source> IS ASSIGNED.

  ENDLOOP."lit_source ASSIGNING <lfs_source>.

  LOOP AT lit_target ASSIGNING <lfs_target>.

    CLEAR: wa_final_gra.

    IF <lfs_target> IS ASSIGNED.

      MOVE: <lfs_target>+0(69)  TO wa_final_gra-graphic,
            <lfs_target>+70(4)  TO l_type.

      IF l_type EQ lc_bcol.
        MOVE:  lc_color TO wa_final_gra-type.
      ELSEIF l_type EQ lc_bmon.
        MOVE: lc_bw TO wa_final_gra-type.
      ENDIF."l_type EQ 'BCOL'.

      MOVE: 'No'            TO wa_final_gra-source.
      MOVE: 'Yes'            TO wa_final_gra-target.

      APPEND wa_final_gra TO it_final_gra.

    ENDIF."<lfs_target> IS ASSIGNED.

  ENDLOOP."lit_target ASSIGNING <lfs_target>.

  SORT it_final_gra BY graphic type source target .

  DELETE ADJACENT DUPLICATES FROM it_final_gra COMPARING ALL FIELDS.

  IF  it_final_gra IS NOT INITIAL.

    CLEAR it_fieldcat.

    PERFORM z_fieldcat USING 'GRAPHIC' 'Name'      'IT_FINAL_GRA'  18 c_x space.
    PERFORM z_fieldcat USING 'TYPE'    'Type'       'IT_FINAL_GRA'  18 c_x space.
    PERFORM z_fieldcat USING 'SOURCE'  g_srcsys     'IT_FINAL_GRA' 18 c_x space.
    PERFORM z_fieldcat USING 'TARGET'  g_tgtsys     'IT_FINAL_GRA' 18 c_x space.

    CLEAR wa_sort.
    CLEAR it_sort.

    MOVE: '1'                TO wa_sort-spos,
          'GRAPHIC'          TO wa_sort-fieldname,
          'IT_FINAL_GRA'     TO wa_sort-tabname.

    APPEND wa_sort TO it_sort.

    PERFORM z_output_alv TABLES it_final_gra.
  ELSE.
    MESSAGE 'There are no differences in the list of graphics between the two systems' TYPE 'I'.

  ENDIF. "it_final_gra IS NOT INITIAL.


ENDFORM.                    "z_compare_graphics

