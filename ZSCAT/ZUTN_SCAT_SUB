          environment        = wa_environment
          environment_output = c_x
        TABLES
          environment_table  = it_environment
        EXCEPTIONS
          OTHERS             = 0.
      IF sy-subrc NE 0.
        CLEAR:it_environment.
      ENDIF."sy-subrc NE 0.

    ENDIF."NOT wa_envi_types-doma IS INITIAL

** Reference Type
    IF NOT wa_dd04l-domname IS INITIAL AND  wa_dd04l-refkind EQ lc_r.
      CLEAR wa_environment-type.

      CASE wa_dd04l-reftype.

        WHEN lc_c OR lc_i OR space.
