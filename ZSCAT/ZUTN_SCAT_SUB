      EXPORTING
        environment        = wa_environment
        environment_output = space
      TABLES
        environment_table  = it_environment
      EXCEPTIONS
        OTHERS             = 0.

    IF sy-subrc NE 0.
      CLEAR: it_environment."12June
    ENDIF.


    IF NOT wa_envi_types-para IS INITIAL
       AND NOT wa_dd04l-memoryid IS INITIAL.

      wa_environment-type        = lc_para.
      wa_environment-done        = c_x.
      wa_environment-object      = wa_dd04l-memoryid.
      wa_environment-call_type   = c_dtel.
      wa_environment-call_obj    = wa_dd04l-rollname.

      CALL FUNCTION 'REPOSITORY_ENVIRONMENT_FILL'
        EXPORTING
          environment        = wa_environment
          environment_output = c_x
        TABLES
          environment_table  = it_environment
        EXCEPTIONS
          OTHERS             = 0.

      IF sy-subrc NE 0.
        CLEAR: it_environment.
      ENDIF.


    ENDIF. "NOT wa_envi_types-para IS INITIAL

*   Domains

    IF NOT wa_envi_types-doma IS INITIAL
      AND  NOT wa_dd04l-domname IS INITIAL AND ( wa_dd04l-refkind
      EQ lc_d OR  wa_dd04l-refkind EQ space ).

