*----------------------------------------------------------------------*
FORM z_compare_changepointers .

  TYPES: BEGIN OF lt_tbda2,
           mestyp TYPE edi_mestyp,
           active TYPE ale_active,
         END OF lt_tbda2.


  DATA: l_table         TYPE dd02l-tabname,
        lit_opt         TYPE TABLE OF rfc_db_opt,
        lit_fld         TYPE TABLE OF rfc_db_fld,
        lit_source      TYPE TABLE OF tab512,
        lit_target      TYPE TABLE OF tab512,
        lwa_opt         TYPE rfc_db_opt,
        lwa_fld         TYPE rfc_db_fld,
        lwa_chpt        TYPE t_final_chpt,
        l_type          TYPE tdbtype,
        l_sourcetext    TYPE scrtext_l,
        l_targettext    TYPE scrtext_l,
        lwa_tbda2       TYPE lt_tbda2,
        lit_src_tbda    TYPE TABLE OF lt_tbda2,
        lit_tgt_tbda    TYPE TABLE OF lt_tbda2,
        wa_final_change TYPE t_final_change,
        it_final_change TYPE TABLE OF t_final_change.



  FIELD-SYMBOLS: <lfs_source> TYPE tab512,
                 <lfs_target> TYPE tab512,
                 <lfs_tbda2>  TYPE lt_tbda2.

  CLEAR: l_sourcetext,
         l_targettext.

*"Populate the table to be used
  MOVE: 'TBDA2' TO l_table.

*"Populate the field list
  CLEAR: lwa_fld.

  MOVE: 'MESTYP'  TO  lwa_fld-fieldname,
        '30'         TO  lwa_fld-length   .

  APPEND  lwa_fld   TO lit_fld.

  CLEAR:  lwa_fld.

  MOVE: 'ACTIVE' TO  lwa_fld-fieldname,
        '1'   TO lwa_fld-length.

  APPEND lwa_fld TO lit_fld.


*"Perform read table from source and destination
  PERFORM z_read_tables USING l_table
                              lit_opt
                              lit_opt
                              lit_fld
                              p_scrfc
                              p_tcrfc
                     CHANGING lit_source
                              lit_target.


*Split Source Table

  LOOP AT lit_source ASSIGNING <lfs_source>.
    MOVE: <lfs_source>+0(30) TO lwa_tbda2-mestyp,
          <lfs_source>+30(1)  TO lwa_tbda2-active.
    APPEND lwa_tbda2 TO lit_src_tbda.
    CLEAR lwa_tbda2.
  ENDLOOP.

*Split Target Table

  LOOP AT lit_target ASSIGNING <lfs_target>.
    MOVE: <lfs_target>+0(30) TO lwa_tbda2-mestyp,
          <lfs_target>+30(1)  TO lwa_tbda2-active.
    APPEND lwa_tbda2 TO lit_tgt_tbda.
    CLEAR lwa_tbda2.
  ENDLOOP.

  SORT lit_src_tbda BY mestyp.
  SORT lit_tgt_tbda BY mestyp.

  LOOP AT lit_src_tbda ASSIGNING <lfs_tbda2>.
    READ TABLE lit_tgt_tbda INTO lwa_tbda2 WITH KEY mestyp = <lfs_tbda2>-mestyp BINARY SEARCH.
    IF sy-subrc = 0.
      wa_final_change-mestyp = <lfs_tbda2>-mestyp.
      IF <lfs_tbda2>-active = 'X' AND lwa_tbda2-active = space.
        wa_final_change-source = 'Active'.
        wa_final_change-target = 'Inactive'.
      ELSEIF <lfs_tbda2>-active = space AND lwa_tbda2-active = 'X'.
        wa_final_change-source = 'Inactive'.
        wa_final_change-target = 'Active'.
      ENDIF.
      DELETE TABLE lit_tgt_tbda FROM lwa_tbda2.
    ELSE.
      wa_final_change-mestyp = <lfs_tbda2>-mestyp.
      wa_final_change-source = 'Available'.
      wa_final_change-target = 'Not Available'.
    ENDIF.
    APPEND wa_final_change TO it_final_change.
    CLEAR wa_final_change.
  ENDLOOP.

  LOOP AT lit_tgt_tbda ASSIGNING <lfs_tbda2>.
    wa_final_change-mestyp = <lfs_tbda2>-mestyp.
    wa_final_change-source = 'Not Available'.
    wa_final_change-target = 'Available'.
    APPEND wa_final_change TO it_final_change.
    CLEAR wa_final_change.
  ENDLOOP.

  SORT it_final_change  BY mestyp active source target .

  DELETE ADJACENT DUPLICATES FROM it_final_change COMPARING ALL FIELDS.
  IF  it_final_change IS NOT INITIAL.

    CLEAR it_fieldcat.

    PERFORM z_fieldcat USING 'MESTYP' 'MESSAGE'      'IT_FINAL_CHANGE'  18 c_x space.
    PERFORM z_fieldcat USING 'SOURCE'  g_srcsys     'IT_FINAL_CHANGE' 18 c_x space.
    PERFORM z_fieldcat USING 'TARGET'  g_tgtsys     'IT_FINAL_CHANGE' 18 c_x space.

    CLEAR wa_sort.
    CLEAR it_sort.

    MOVE: '1'                TO wa_sort-spos,
          'MESTYP'          TO wa_sort-fieldname,
          'IT_FINAL_CHANGE'     TO wa_sort-tabname.

    APPEND wa_sort TO it_sort.

    PERFORM z_output_alv TABLES it_final_change.
  ELSE.
    MESSAGE 'There are no differences in the list of change pointers between the two systems' TYPE 'I'.
  ENDIF.








