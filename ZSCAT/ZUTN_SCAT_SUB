*&      Form  Z_COMPARE_VARIANTS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM z_compare_variants .

  CONSTANTS: lc_y TYPE c LENGTH 2 VALUE 'Y%',
             lc_z TYPE c LENGTH 2 VALUE 'Z%'.

  DATA: l_table    TYPE dd02l-tabname,
        lit_opt    TYPE TABLE OF rfc_db_opt,
        lit_fld    TYPE TABLE OF rfc_db_fld,
        lit_source TYPE TABLE OF tab512,
        lit_target TYPE TABLE OF tab512,
        lwa_opt    TYPE rfc_db_opt,
        lwa_fld    TYPE rfc_db_fld.

  FIELD-SYMBOLS: <fs_source> TYPE tab512,
                 <fs_target> TYPE tab512.


* Populate the table to be used

  MOVE: 'VARID' TO l_table.

* Populate the field list

  CLEAR: lwa_fld.
  MOVE: 'REPORT' TO  lwa_fld-fieldname,
        '40'   TO  lwa_fld-length.
  APPEND  lwa_fld TO lit_fld.

  CLEAR:  lwa_fld.
  MOVE: 'VARIANT' TO  lwa_fld-fieldname,
        '14'   TO lwa_fld-length.
  APPEND lwa_fld TO lit_fld.

* Populate the condition for data fetching

  CLEAR: lwa_opt.

  CONCATENATE 'REPORT LIKE ''' lc_z c_comma ' OR REPORT LIKE ''' lc_y c_comma INTO lwa_opt-text.
  APPEND lwa_opt TO lit_opt.
  CLEAR: lwa_opt.

* Perform read table from source and destination

  PERFORM z_read_tables USING l_table lit_opt lit_opt lit_fld p_scrfc p_tcrfc CHANGING lit_source lit_target.

* Popukate the final table

  CLEAR: it_final_var.

  LOOP AT lit_source ASSIGNING <fs_source>.

    CLEAR: wa_final_var.

    IF <fs_source> IS ASSIGNED.

      MOVE: <fs_source>+0(39)  TO wa_final_var-report,
            <fs_source>+40(20) TO wa_final_var-variant,
            'Yes'            TO wa_final_var-source,
            'No'            TO wa_final_var-target.

      APPEND wa_final_var TO it_final_var.

    ENDIF."<fs_source> IS ASSIGNED.

  ENDLOOP."lit_source ASSIGNING <fs_source>.

  LOOP AT lit_target ASSIGNING <fs_target>.

    CLEAR: wa_final_var.

    IF <fs_target> IS ASSIGNED.

      MOVE: <fs_target>+0(39)  TO wa_final_var-report,
            <fs_target>+40(14) TO wa_final_var-variant,
            'No'            TO wa_final_var-source,
            'Yes'            TO wa_final_var-target.

      APPEND wa_final_var TO it_final_var.

    ENDIF."<fs_target> IS ASSIGNED.

  ENDLOOP."lit_target ASSIGNING <fs_target>.

  SORT it_final_var BY report variant.

  DELETE ADJACENT DUPLICATES FROM it_final_var COMPARING ALL FIELDS.

  IF it_final_var IS NOT INITIAL.

    PERFORM z_fieldcat USING 'REPORT' 'Report' 'IT_FINAL_VAR' 18 'X' space." CHANGING p_it_fieldcat.
    PERFORM z_fieldcat USING 'VARIANT' 'Variant' 'IT_FINAL_VAR' 18 'X' space." CHANGING p_it_fieldcat.
    PERFORM z_fieldcat USING 'SOURCE' g_srcsys 'IT_FINAL_VAR' 18 c_x space.
    PERFORM z_fieldcat USING 'TARGET' g_tgtsys 'IT_FINAL_VAR' 18 c_x space.
    PERFORM z_output_alv TABLES it_final_var.
  ELSE.
    MESSAGE 'There are no differences in the Variants between the two systems' TYPE 'I'.
  ENDIF.

ENDFORM.                    " Z_COMPARE_VARIANTS

