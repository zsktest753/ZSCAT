FORM z_compare_mesg.

  CONSTANTS: lc_y     TYPE c LENGTH 2 VALUE 'Y%',
             lc_z     TYPE c LENGTH 2 VALUE 'Z%',
             lc_t100t TYPE dd02l-tabname VALUE 'T100T',
             lc_1     TYPE ddleng VALUE '1',
             lc_20    TYPE ddleng VALUE '20',
             lc_60    TYPE ddleng VALUE '60',
             lc_sprsl TYPE fieldname VALUE 'SPRSL',
             lc_arbgb TYPE fieldname VALUE 'ARBGB',
             lc_stext TYPE fieldname VALUE 'STEXT'.

  DATA: l_table      TYPE dd02l-tabname, " PBISHT 13JAN2015(+)
        lit_opt      TYPE TABLE OF rfc_db_opt,
        lit_fld      TYPE TABLE OF rfc_db_fld,
        lit_source   TYPE TABLE OF tab512,
        lit_target   TYPE TABLE OF tab512,
        lwa_opt      TYPE rfc_db_opt,
        lwa_fld      TYPE rfc_db_fld,
        l_sourcetext TYPE scrtext_l,
        l_targettext TYPE scrtext_l.


  FIELD-SYMBOLS: <lfs_source> TYPE tab512, " PBISHT 13JAN2015(+)
                 <lfs_target> TYPE tab512. " PBISHT 13JAN2015(+)

  CLEAR: l_sourcetext,
         l_targettext.

* Populate the table to be used

*  MOVE: 'T100T' TO l_table. " PBISHT 13JAN2015(+)
  MOVE: lc_t100t TO l_table. " PBISHT 13JAN2015(+)

* Populate the field list

  CLEAR: lwa_fld.
  MOVE: lc_sprsl TO  lwa_fld-fieldname,
        lc_1     TO  lwa_fld-length.
*  MOVE: 'SPRSL' TO  lwa_fld-fieldname,
*        '1'     TO  lwa_fld-length.
  APPEND  lwa_fld TO lit_fld.

  CLEAR: lwa_fld.
*  MOVE: 'ARBGB' TO  lwa_fld-fieldname,
*        '20'    TO  lwa_fld-length.

  MOVE: lc_arbgb TO  lwa_fld-fieldname,
       lc_20    TO  lwa_fld-length.

  APPEND  lwa_fld TO lit_fld.

  CLEAR: lwa_fld.
  MOVE: lc_stext TO  lwa_fld-fieldname,
        lc_60     TO  lwa_fld-length.

*    MOVE: 'STEXT' TO  lwa_fld-fieldname,
*        '60'     TO  lwa_fld-length.
  APPEND  lwa_fld TO lit_fld.


* Populate the condition for data fetching

  CLEAR: lwa_opt.

  CONCATENATE 'ARBGB LIKE ''' lc_z c_comma ' OR ARBGB LIKE ''' lc_y c_comma  INTO lwa_opt-text.
  APPEND lwa_opt TO lit_opt.
  CLEAR: lwa_opt.

* Perform read table from source and destination

  PERFORM z_read_tables USING l_table lit_opt lit_opt lit_fld p_scrfc p_tcrfc CHANGING lit_source lit_target.

* Populate final table

  CLEAR: it_final_msg.  " PBISHT-21JAN2015

  LOOP AT lit_source
    ASSIGNING <lfs_source>. " PBISHT 13JAN2015(+)

    CLEAR: wa_final_msg.

    IF <lfs_source> IS ASSIGNED. " PBISHT 13JAN2015(+)

      MOVE: <lfs_source>+0(1)     TO wa_final_msg-spsrl,  " PBISHT 13JAN2015(+)
            <lfs_source>+1(20)    TO wa_final_msg-arbgb, " PBISHT 13JAN2015(+)
            <lfs_source>+21(60)   TO wa_final_msg-stext, " PBISHT 13JAN2015(+)
*            p_scrfc              TO wa_final_msg-system.
            'Yes' TO wa_final_msg-source,
            'No' TO wa_final_msg-target.
      APPEND wa_final_msg TO it_final_msg.

    ENDIF.

  ENDLOOP.

  SORT it_final_msg BY spsrl arbgb stext.

  LOOP AT lit_target
    ASSIGNING <lfs_target>.

    CLEAR: wa_final_msg.

    IF <lfs_target> IS ASSIGNED.

      MOVE: <lfs_target>+0(1)     TO wa_final_msg-spsrl,
            <lfs_target>+1(20)    TO wa_final_msg-arbgb,
            <lfs_target>+21(60)   TO wa_final_msg-stext.
*            p_tcrfc              TO wa_final_msg-system.

      READ TABLE it_final_msg INTO wa_final_msg WITH KEY
                         spsrl = wa_final_msg-spsrl
                         arbgb = wa_final_msg-arbgb
                         stext = wa_final_msg-stext
                         BINARY SEARCH.
      IF sy-subrc = 0.
        MOVE : 'Yes' TO wa_final_msg-target,
               'Yes' TO wa_final_msg-source.
      ELSE.
        MOVE : 'Yes' TO wa_final_msg-target,
               'No' TO wa_final_msg-source.
      ENDIF.

      APPEND wa_final_msg TO it_final_msg.

    ENDIF. " <fs_target> IS ASSIGNED.

  ENDLOOP."lit_target ASSIGNING <fs_target>.

  SORT it_final_msg BY arbgb.

  DELETE ADJACENT DUPLICATES FROM it_final_msg COMPARING ALL FIELDS.

  IF it_final_msg IS NOT INITIAL.

    CLEAR it_fieldcat.

    PERFORM z_fieldcat USING 'SPSRL' 'Language Key' 'IT_FINAL_MSG' 18 c_x space.
    PERFORM z_fieldcat USING 'ARBGB' 'Message Class' 'IT_FINAL_MSG' 18 c_x space .
    PERFORM z_fieldcat USING 'STEXT' 'Description' 'IT_FINAL_MSG' 18 c_x space.
    PERFORM z_fieldcat USING 'SOURCE' g_srcsys 'IT_FINAL_MSG' 18 c_x space.
    PERFORM z_fieldcat USING 'TARGET' g_tgtsys 'IT_FINAL_MSG' 18 c_x space.
    PERFORM z_output_alv TABLES it_final_msg.

  ELSE.
    MESSAGE 'There are no differences in the Message Classes between the two systems' TYPE 'I'.

  ENDIF.




ENDFORM.                    "mesg_compare

