    SELECT rollname domname memoryid shlpname refkind reftype
           FROM dd04l
           INTO TABLE it_dd04l
           FOR ALL ENTRIES IN it_roll
           WHERE rollname EQ it_roll-rollname.
    IF sy-subrc EQ 0.
      SORT it_dd04l BY rollname.
