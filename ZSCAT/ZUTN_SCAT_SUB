      ENDIF." sy-subrc EQ 0.

    ENDLOOP."lit_data_q INTO lwa_data_q.

  ELSEIF l_lin_q EQ l_lin_p.

    CLEAR lit_trkorr.

  ENDIF."l_lin_q GT l_lin_p.

  SORT lit_trkorr BY trkorr.
  DELETE ADJACENT DUPLICATES FROM lit_trkorr COMPARING ALL FIELDS.
  CLEAR: wa_e071.

