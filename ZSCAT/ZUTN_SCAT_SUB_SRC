        CLEAR: l_inc.
        CONCATENATE lc_fixprgname lwa_formname-fmnumb_t lc_top INTO l_inc.
        lwa_formname-sys_top_t = l_inc.

        CLEAR: l_inc.
        CONCATENATE lc_fixprgname lwa_formname-fmnumb_t lc_f01 INTO l_inc.
        lwa_formname-sys_f01_t = l_inc.

        CLEAR: l_inc.
        CONCATENATE lc_fixprgname lwa_formname-fmnumb_t lc_uxx INTO l_inc.
        lwa_formname-sys_uxx_t = l_inc.

      ENDIF. "<lfs_data> IS ASSIGNED.

    ENDLOOP."lit_data ASSIGNING <lfs_data>.

    APPEND lwa_formname TO lit_formname.

