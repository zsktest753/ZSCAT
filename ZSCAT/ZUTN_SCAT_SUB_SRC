        CLEAR: l_inc.
        CONCATENATE lc_fixprgname lwa_formname-fmnumb_s lc_uxx INTO l_inc.
        lwa_formname-sys_uxx_s = l_inc.

      ENDIF. "<lfs_data> IS ASSIGNED.

    ENDLOOP."lit_data ASSIGNING <lfs_data>.

    LOOP AT lit_data_t ASSIGNING <lfs_data>.

      IF <lfs_data> IS ASSIGNED.

        CLEAR: lwa_formname.

        lwa_formname-fmnumb_t   = <lfs_data>+30(8) .

        CLEAR: l_fm.
        CONCATENATE lc_fixname lwa_formname-fmnumb_t INTO l_fm.
