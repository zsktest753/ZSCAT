FORM z_compare_fugr USING    fp_it_fugr TYPE ty_tadir
                    CHANGING fp_it_conop TYPE ty_conf_output.

  DATA: l_objname  TYPE trobj_name,
        l_objtype  TYPE vrsd-objtype,
        l_fungrnm  TYPE tfdir-pname,
        l_conf     TYPE c LENGTH 40,
        l_tx_confl TYPE c LENGTH 40,
        l_table    TYPE dd02l-tabname.

  DATA: lit_func  TYPE TABLE OF t_tfdir,
        lit_tftit TYPE TABLE OF tftit,
        lit_conop TYPE TABLE OF t_conf_output,
        lit_tadir TYPE TABLE OF t_tadir,
        lit_fugr  TYPE TABLE OF t_tadir,
        lit_opt   TYPE TABLE OF rfc_db_opt,
        lit_data  TYPE TABLE OF tab512,
        lit_fld   TYPE TABLE OF rfc_db_fld,

        lwa_opt   TYPE rfc_db_opt,
        lwa_fld   TYPE rfc_db_fld,
        lwa_conop TYPE t_conf_output,
        lwa_tadir TYPE t_tadir,
        lwa_tftit TYPE tftit,
        lwa_tfdir TYPE t_tfdir,
        lwa_func  TYPE t_tfdir,
        lwa_col   TYPE slis_specialcol_alv.

  DATA: r_ctrfc TYPE RANGE OF rfcdes-rfcdest.

  FIELD-SYMBOLS: <lfs_func>      TYPE t_tfdir,
                 <lfs_tftit>     TYPE tftit,
                 <lfs_fugr>      TYPE t_tadir,
                 <lfs_rfc_confl> TYPE t_rfc_confl,
                 <lfs_data>      TYPE tab512,
                 <lfs_ctrfc>     LIKE LINE OF r_ctrfc.

  lit_fugr[] =  fp_it_fugr[].

  LOOP AT lit_fugr ASSIGNING <lfs_fugr>.

    CLEAR: l_fungrnm.
    CLEAR: lit_func, lit_tftit.

*   In TFDIR-PNAME, the FG name is prepended by SAPL.

    CONCATENATE c_sapl <lfs_fugr>-obj_name INTO l_fungrnm.
    l_objtype = c_fugp.

*   Select Function Module list from Source System

    SELECT funcname pname
      INTO TABLE lit_func
      FROM tfdir
     WHERE pname EQ l_fungrnm.

    IF sy-subrc NE 0 .
      CLEAR: lit_func.
    ENDIF. "sy-subrc NE 0

*   Select Function Module list from Target Systems

    l_table = 'TFDIR'.

    CLEAR: lwa_fld.
    MOVE: 'FUNCNAME' TO  lwa_fld-fieldname,
          '30'        TO  lwa_fld-length.
    APPEND  lwa_fld TO lit_fld.

    CLEAR: lwa_fld.
    MOVE: 'PNAME' TO  lwa_fld-fieldname,
          '40'        TO  lwa_fld-length.
    APPEND  lwa_fld TO lit_fld.

    CLEAR: lwa_opt.
    CONCATENATE 'PNAME EQ ''' l_fungrnm c_comma  INTO lwa_opt-text.
    APPEND lwa_opt TO lit_opt.
    CLEAR: lwa_opt.

    LOOP AT s_ctrfc ASSIGNING <lfs_ctrfc>.

      CLEAR lit_data.

      CALL FUNCTION 'RFC_READ_TABLE' DESTINATION <lfs_ctrfc>-low
        EXPORTING
          query_table          = l_table
        TABLES
          options              = lit_opt
          fields               = lit_fld
          data                 = lit_data
        EXCEPTIONS
          table_not_available  = 1
          table_without_data   = 2
          option_not_valid     = 3
          field_not_valid      = 4
          not_authorized       = 5
          data_buffer_exceeded = 6
          OTHERS               = 7.
      IF sy-subrc NE 0.
        CLEAR: lit_data.
      ELSE.

        LOOP AT lit_data ASSIGNING <lfs_data>.

          IF <lfs_data> IS ASSIGNED.
