        not_authorized       = 5
        data_buffer_exceeded = 6
        OTHERS               = 7.
    IF sy-subrc NE 0.
      CLEAR: lit_data_s.
    ENDIF. "sy-subrc NE 0.

*   Read the internal SF number from Target

    CALL FUNCTION 'RFC_READ_TABLE' DESTINATION s_ctrfc-low
      EXPORTING
        query_table          = l_table
      TABLES
        options              = lit_opt
        fields               = lit_fld
        data                 = lit_data_t
      EXCEPTIONS
        table_not_available  = 1
        table_without_data   = 2
        option_not_valid     = 3
        field_not_valid      = 4
        not_authorized       = 5
        data_buffer_exceeded = 6
        OTHERS               = 7.
    IF sy-subrc NE 0.
      CLEAR: lit_data_t.
    ENDIF. "sy-subrc NE 0.

*   Prepare a table with form name and source/target includes

    LOOP AT lit_data_s ASSIGNING <lfs_data>.

      IF <lfs_data> IS ASSIGNED.

        CLEAR: lwa_formname.

        lwa_formname-formname = <lfs_data>+0(30).
