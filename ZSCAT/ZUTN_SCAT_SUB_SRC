FORM z_compare_obj USING fp_oname fp_prgname fp_obtype." CHANGING it_rfc_confl.

  DATA: lit_rep_left    TYPE TABLE OF abaptxt255,
        lit_rep_rt      TYPE TABLE OF abaptxt255,
        lit_trdir_left  TYPE TABLE OF trdir,
        lit_trdir_rt    TYPE TABLE OF trdir,
        lit_abap_delta  TYPE TABLE OF vxabapt255,
        lit_trdir_delta TYPE TABLE OF xtrdir,
        lit_sver        TYPE TABLE OF vrsd,
        lit_lversno     TYPE TABLE OF vrsn,
        lit_repot_left  TYPE TABLE OF textpoolt,
        lit_repot_rt    TYPE TABLE OF textpoolt,
        lit_repot_delta TYPE TABLE OF xtextpool,
        lit_fld         TYPE TABLE OF rfc_db_fld,
        lit_opt         TYPE TABLE OF rfc_db_opt,
        lit_data        TYPE TABLE OF tab512,

        lwa_opt         TYPE rfc_db_opt,
        lwa_fld         TYPE rfc_db_fld,

        l_objname       TYPE vrsd-objname,
        l_reptname      TYPE vrsd-objname,
        l_objtype       TYPE vrsd-objtype,
        l_conflict      TYPE c LENGTH 1,
        l_versn_sr      TYPE vrsd-versno,
        l_versn_sr_rept TYPE vrsd-versno,
        l_versn_tr      TYPE vrsd-versno,
        l_versn_tr_rept TYPE vrsd-versno,
        l_src_tr        TYPE korrnum,
        l_src_sr        TYPE korrnum,
        l_auth_sr       TYPE vrsd-author,
        l_auth_tr       TYPE vrsd-author,
        l_dat_sr        TYPE vrsd-datum,
        l_dat_tr        TYPE vrsd-datum,
        l_table         TYPE dd02l-tabname.

  DATA: r_ctrfc TYPE RANGE OF rfcdes-rfcdest.

  FIELD-SYMBOLS: <lfs_sver>     TYPE vrsd,
                 <lfs_ctrfc>    LIKE LINE OF r_ctrfc,
                 <lfs_inactive> TYPE t_inactive,
                 <lfs_data>     TYPE tab512.

  l_objname  = fp_oname.
  l_objtype  = fp_obtype.
  l_reptname = fp_prgname.


* Get the version in the source system

  CLEAR: lit_sver,
           lit_lversno.

  CALL FUNCTION 'SVRS_GET_VERSION_DIRECTORY_46'
    EXPORTING
      destination            = p_csrfc
      objname                = l_objname
      objtype                = l_objtype
    TABLES
      lversno_list           = lit_lversno
      version_list           = lit_sver
    EXCEPTIONS
      no_entry               = 1
      communication_failure_ = 2
      system_failure         = 3
      OTHERS                 = 4.

  IF sy-subrc NE 0.
    CLEAR lit_sver.
  ENDIF. "sy-subrc NE 0.

* Read the latest version number

  CLEAR: l_src_sr,
         l_versn_sr,
         l_auth_sr,
         l_dat_sr.

* Check for inactive version

  SORT lit_sver BY versno DESCENDING.

  READ TABLE lit_sver ASSIGNING <lfs_sver> INDEX 1.

  IF sy-subrc EQ 0 AND <lfs_sver> IS ASSIGNED.

    IF <lfs_sver>-versno EQ c_99999. "Inactive version.

      l_versn_sr  = <lfs_sver>-versno.
      l_src_sr    = <lfs_sver>-korrnum.
      l_auth_sr   =  <lfs_sver>-author.
      l_dat_sr    =  <lfs_sver>-datum.

    ENDIF."<lfs_sver>-versno EQ '9999'.

  ENDIF."sy-subrc EQ 0

* If no inactive version is found get the latest version

  IF l_versn_sr IS INITIAL.

    SORT lit_sver BY versno ASCENDING.

    READ TABLE lit_sver ASSIGNING <lfs_sver> INDEX 1.

    IF sy-subrc EQ 0 AND <lfs_sver> IS ASSIGNED.

      l_versn_sr  = <lfs_sver>-versno.
      l_src_sr    = <lfs_sver>-korrnum.
      l_auth_sr  =  <lfs_sver>-author.
      l_dat_sr  =  <lfs_sver>-datum.

    ENDIF. "<lfs_sver> IS ASSIGNED.

  ENDIF. "l_vers_sr IS INITIAL

* Get the source code from the source system based on the version

  CALL FUNCTION 'SVRS_GET_REPS_FROM_OBJECT'
    EXPORTING
      object_name                  = l_objname
      object_type                  = l_objtype
      versno                       = l_versn_sr
      destination                  = p_csrfc
      iv_no_release_transformation = space
    TABLES
      repos_tab                    = lit_rep_left
      trdir_tab                    = lit_trdir_left
    EXCEPTIONS
      no_version                   = 1
      OTHERS                       = 2.

  IF sy-subrc NE 0.

    CLEAR: lit_rep_left,
             lit_trdir_left.

  ENDIF. "sy-subrc NE 0.

  CLEAR: it_inactive.

  SELECT object obj_name
    FROM dwinactiv
    INTO TABLE it_inactive
   WHERE object   EQ c_rept
    AND  obj_name EQ l_reptname.

  IF sy-subrc EQ 0.
    MOVE: c_99999 TO l_versn_sr_rept.
  ELSE.
    MOVE: l_versn_sr TO l_versn_sr_rept.
  ENDIF. "sy-subrc EQ 0

  CALL FUNCTION 'SVRS_GET_VERSION_REPT_40'
    EXPORTING
      destination           = p_csrfc
      object_name           = l_reptname
      versno                = l_versn_sr_rept
    TABLES
      repot_tab             = lit_repot_left
    EXCEPTIONS
      no_version            = 1
      system_failure        = 2
      communication_failure = 3
      OTHERS                = 4.
  IF sy-subrc <> 0.
    CLEAR lit_repot_left.
  ENDIF.

* Get the version in the TARGET system(s)

  CLEAR: it_rfc_confl.

  LOOP AT s_ctrfc ASSIGNING <lfs_ctrfc>.

    CLEAR: lit_sver,
           lit_lversno.

    CLEAR: wa_rfc_confl,
           l_versn_tr,
           l_src_tr,
           l_auth_tr,
           l_dat_tr.

    CALL FUNCTION 'SVRS_GET_VERSION_DIRECTORY_46'
      EXPORTING
        destination            = <lfs_ctrfc>-low
        objname                = l_objname
        objtype                = l_objtype
      TABLES
        lversno_list           = lit_lversno
        version_list           = lit_sver
      EXCEPTIONS
        no_entry               = 1
        communication_failure_ = 2
        system_failure         = 3
        OTHERS                 = 4.

    IF sy-subrc NE 0.
      CLEAR lit_sver.
    ENDIF. "sy-subrc NE 0.

*   Read the latest version number

*   Check for inactive version

    SORT lit_sver BY versno DESCENDING.

    READ TABLE lit_sver ASSIGNING <lfs_sver> INDEX 1.

    IF sy-subrc EQ 0 AND <lfs_sver> IS ASSIGNED.

      IF <lfs_sver>-versno EQ c_99999. "Inactive version.

        l_versn_tr  = <lfs_sver>-versno.
        l_src_tr    = <lfs_sver>-korrnum.
        l_auth_tr   = <lfs_sver>-author.
        l_dat_tr    = <lfs_sver>-datum.

      ENDIF."<lfs_sver>-versno EQ '9999'.

    ENDIF."sy-subrc EQ 0

*   If no inactive version, get the latest version no

    IF l_versn_tr IS INITIAL.

      SORT lit_sver BY versno ASCENDING.

      READ TABLE lit_sver ASSIGNING <lfs_sver> INDEX 1.

      IF sy-subrc EQ 0 AND <lfs_sver> IS ASSIGNED.

        l_versn_tr = <lfs_sver>-versno.
        MOVE: <lfs_sver>-korrnum TO l_src_tr.
        l_auth_tr  =  <lfs_sver>-author.
        l_dat_tr  =  <lfs_sver>-datum.

      ENDIF. "<lfs_sver> IS ASSIGNED

    ENDIF."l_versn_tr IS INITIAL.

*   Get the source code at the target based on the latest version

    CALL FUNCTION 'SVRS_GET_REPS_FROM_OBJECT'
      EXPORTING
        object_name                  = l_objname
        object_type                  = l_objtype
        versno                       = l_versn_tr
        destination                  = <lfs_ctrfc>-low
        iv_no_release_transformation = space
      TABLES
        repos_tab                    = lit_rep_rt
        trdir_tab                    = lit_trdir_rt
      EXCEPTIONS
        no_version                   = 1
        OTHERS                       = 2.

    IF sy-subrc NE 0.
      CLEAR: lit_rep_rt,
               lit_trdir_rt.
    ENDIF. "sy-subrc NE 0.

*   Find if Report texts are Inactive at the target

    l_table = 'DWINACTIV'.

    CLEAR: lwa_fld.
    MOVE: 'OBJECT' TO  lwa_fld-fieldname,
          '4'        TO  lwa_fld-length.
    APPEND  lwa_fld TO lit_fld.

    CLEAR: lwa_fld.
    MOVE: 'OBJ_NAME' TO  lwa_fld-fieldname,
          '120'        TO  lwa_fld-length.
    APPEND  lwa_fld TO lit_fld.

    CLEAR: lwa_opt.
    CONCATENATE 'OBJECT EQ ''' c_rept c_comma' AND OBJ_NAME EQ ''' l_reptname c_comma  INTO lwa_opt-text.
    APPEND lwa_opt TO lit_opt.
    CLEAR: lwa_opt.

    CALL FUNCTION 'RFC_READ_TABLE' DESTINATION <lfs_ctrfc>-low
      EXPORTING
        query_table          = l_table
      TABLES
        options              = lit_opt
        fields               = lit_fld
        data                 = lit_data
      EXCEPTIONS
        table_not_available  = 1
        table_without_data   = 2
        option_not_valid     = 3
        field_not_valid      = 4
        not_authorized       = 5
        data_buffer_exceeded = 6
        OTHERS               = 7.
    IF sy-subrc NE 0.
      CLEAR: lit_data.
    ENDIF. "<lfs_clas> IS ASSIGNED.

    READ TABLE lit_data ASSIGNING <lfs_data> INDEX 1.
    IF sy-subrc EQ 0 AND <lfs_data> IS ASSIGNED.
      MOVE: c_99999 TO  l_versn_tr_rept.
    ELSE.
      MOVE: l_versn_tr TO l_versn_tr_rept.
    ENDIF."sy-subrc EQ 0 AND <lfs_data> IS ASSIGNED

    CALL FUNCTION 'SVRS_GET_VERSION_REPT_40'
      EXPORTING
        destination           = <lfs_ctrfc>-low
        object_name           = l_reptname
        versno                = l_versn_tr_rept
      TABLES
        repot_tab             = lit_repot_rt
      EXCEPTIONS
        no_version            = 1
        system_failure        = 2
        communication_failure = 3
        OTHERS                = 4.
    IF sy-subrc <> 0.
      CLEAR lit_repot_rt.
    ENDIF.

*    ENDIF. "p_prog IS NOT INITIAL.

    IF l_versn_sr EQ c_99999.

      MOVE: 'Inactive version at source'(082) TO wa_rfc_confl-conf_flag.

    ENDIF. "l_versn_sr EQ c_99999.

    IF l_versn_tr EQ c_99999.

      MOVE: 'Inactive version at target'(083) TO wa_rfc_confl-conf_flag.

    ENDIF. "l_versn_tr EQ c_99999.

* Compare two source codes from source and target.

    IF wa_rfc_confl-conf_flag IS INITIAL.

      CALL FUNCTION 'SVRS_COMPUTE_DELTA_REPS'
        EXPORTING
          compare_mode            = 1
          ignore_case_differences = c_x
        TABLES
          texttab_old             = lit_rep_left
          texttab_new             = lit_rep_rt
          trdirtab_old            = lit_trdir_left
          trdirtab_new            = lit_trdir_rt
          trdir_delta             = lit_trdir_delta
          text_delta              = lit_abap_delta.

      IF lit_abap_delta IS NOT INITIAL.
*   If there is a difference found in the two source codes, set conflict as 'X'.

        IF lit_rep_left IS INITIAL.

          MOVE: 'Object does not exist in source'(079) TO wa_rfc_confl-conf_flag.

        ELSEIF lit_rep_rt IS INITIAL.

          MOVE:'Object does not exist in target'(078) TO wa_rfc_confl-conf_flag.

        ELSE.

          MOVE:'Differences exist'(076)  TO wa_rfc_confl-conf_flag.

        ENDIF. "lit_rep_left IS INITIAL.

      ELSE.

*       If there is no difference found in the two source codes, set conflict as 'space'.

        MOVE: 'No Differences'(077)  TO wa_rfc_confl-conf_flag.

      ENDIF. "lit_abap_delta IS NOT INITIAL.

    ENDIF. "wa_rfc_confl-conf_flag IS NOT INITIAL

*    IF p_prog IS NOT INITIAL.

*     Compare the two text pools

    IF l_versn_sr_rept EQ c_99999.
      MOVE: 'Inactive Texts at Source'(080) TO wa_rfc_confl-conf_flag_text.
    ENDIF.

    IF l_versn_tr_rept EQ c_99999.
      MOVE: 'Inactive Texts at Target'(081) TO wa_rfc_confl-conf_flag_text.
    ENDIF.

    IF wa_rfc_confl-conf_flag_text IS INITIAL.

      IF lit_repot_left IS INITIAL.

        MOVE: 'Object does not exist in source'(079) TO wa_rfc_confl-conf_flag_text.

      ELSEIF lit_repot_rt IS INITIAL.

        MOVE: 'Object does not exist in target'(078) TO wa_rfc_confl-conf_flag_text.

      ELSEIF lines( lit_repot_left ) NE lines( lit_repot_rt ).

        MOVE: 'Differences exist'(076)   TO wa_rfc_confl-conf_flag_text.

      ELSE.

        MOVE: 'No Differences'(077) TO wa_rfc_confl-conf_flag_text.

      ENDIF. "lit_rep_left IS INITIAL.

    ENDIF. "wa_rfc_confl-conf_flag_text IS INITIAL

    MOVE: l_src_sr          TO wa_rfc_confl-sourcetr,
          l_src_tr          TO wa_rfc_confl-targettr,
          l_versn_sr        TO wa_rfc_confl-sourcevr,
          l_versn_tr        TO wa_rfc_confl-targetvr,
          l_auth_sr         TO wa_rfc_confl-sourceauth,
          l_auth_tr         TO wa_rfc_confl-targetauth,
          l_dat_sr          TO wa_rfc_confl-sourcedt,
          l_dat_tr          TO wa_rfc_confl-targetdt,
          <lfs_ctrfc>-low   TO wa_rfc_confl-rfcdest.

    APPEND wa_rfc_confl TO it_rfc_confl.

  ENDLOOP."s_ctrfc ASSIGNING <lfs_ctrfc>.

ENDFORM.                    "z_compare_obj


*&---------------------------------------------------------------------*
*&      Form  z_compare_prog
*&---------------------------------------------------------------------*
*       Logic for code comparison utility - Program
*----------------------------------------------------------------------*

FORM z_compare_prog USING    fp_it_prog  TYPE ty_tadir
                    CHANGING fp_it_conop TYPE ty_conf_output.

  DATA: l_objname  TYPE trobj_name,
        l_objtype  TYPE vrsd-objtype,
        l_conf     TYPE c LENGTH 1,
        l_tx_confl TYPE c LENGTH 1.

  DATA: lit_conop      TYPE TABLE OF t_conf_output,
        lit_prog       TYPE TABLE OF t_tadir,
        lit_prog_title TYPE TABLE OF t_prog_title,
        lwa_conop      TYPE t_conf_output,
        lwa_col        TYPE slis_specialcol_alv.

  FIELD-SYMBOLS: <lfs_prog>      TYPE t_tadir,
                 <fs_prog_title> TYPE t_prog_title,
                 <lfs_rfc_confl> TYPE t_rfc_confl.

  lit_prog[] = fp_it_prog[].

* Get all program titles

  CLEAR lit_prog_title.

  IF lit_prog IS NOT INITIAL.

    SELECT name sprsl text
      FROM trdirt
      INTO TABLE lit_prog_title
      FOR ALL ENTRIES IN lit_prog
      WHERE name EQ lit_prog-obj_name
      AND sprsl EQ 'E'. "English

    IF sy-subrc EQ 0.
      SORT lit_prog_title BY name.
      DELETE ADJACENT DUPLICATES FROM lit_prog_title COMPARING name.
    ENDIF. "sy-subrc EQ 0

  ENDIF. "lit_prog IS NOT INITIAL

  LOOP AT lit_prog ASSIGNING <lfs_prog>.

    l_objname = <lfs_prog>-obj_name. "Program Name
    l_objtype = 'REPS'.
*    CLEAR: l_conf.
*   Compare this object between the two rfc destinations

    PERFORM z_compare_obj USING l_objname l_objname l_objtype." CHANGING l_conf l_tx_confl.

    LOOP AT it_rfc_confl ASSIGNING <lfs_rfc_confl>.

*   Add to the final table
      CLEAR: lwa_conop.

      lwa_conop-prgname  = <lfs_prog>-obj_name. "Program NAme
      lwa_conop-obj_name = <lfs_prog>-obj_name. "Program NAme
      lwa_conop-objtyp   = l_objtype. "PROG"
      lwa_conop-pck      = <lfs_prog>-devclass."Package
      lwa_conop-author   = <lfs_prog>-author."Author

*   Get the description of the object type.
      SORT it_obtab BY object.

      READ TABLE it_obtab ASSIGNING <lfs_obtab>
      WITH KEY object = l_objtype BINARY SEARCH.
      IF sy-subrc EQ 0.
        lwa_conop-objtypedesc = <lfs_obtab>-text. "Obj Type Desc
      ENDIF. "sy-subrc EQ 0.

*   Get the title of the report.

      SORT lit_prog_title BY name.

      READ TABLE lit_prog_title
      ASSIGNING <fs_prog_title>
      WITH KEY name = <lfs_prog>-obj_name BINARY SEARCH.

      IF sy-subrc EQ 0 AND <fs_prog_title> IS ASSIGNED.
        lwa_conop-title = <fs_prog_title>-text.
      ENDIF."sy-subrc EQ

      lwa_conop-rfcdest_s   = p_csrfc.
      lwa_conop-sourcetr    = <lfs_rfc_confl>-sourcetr.
      lwa_conop-sourcevr    = <lfs_rfc_confl>-sourcevr.
      lwa_conop-sourcedt    = <lfs_rfc_confl>-sourcedt.
      lwa_conop-sourceauth  = <lfs_rfc_confl>-sourceauth.
      lwa_conop-rfcdest     = <lfs_rfc_confl>-rfcdest.
      lwa_conop-targettr    = <lfs_rfc_confl>-targettr.
      lwa_conop-targetvr    = <lfs_rfc_confl>-targetvr.
      lwa_conop-targetdt    = <lfs_rfc_confl>-targetdt.
      lwa_conop-targetauth  = <lfs_rfc_confl>-targetauth.
      lwa_conop-conflict    = <lfs_rfc_confl>-conf_flag.
      lwa_conop-tx_conflict = <lfs_rfc_confl>-conf_flag_text.

      CLEAR: lwa_col.

      IF lwa_conop-conflict EQ TEXT-077.

        lwa_col-fieldname = 'CONFLICT'.
        lwa_col-color-col = 5.
        lwa_col-color-int = 1.
        lwa_col-color-inv = 0.
        APPEND lwa_col TO lwa_conop-coltab.

      ELSEIF lwa_conop-conflict EQ TEXT-076.

        lwa_col-fieldname = 'CONFLICT'.
        lwa_col-color-col = 6.
        lwa_col-color-int = 1.
        lwa_col-color-inv = 0.
        APPEND lwa_col TO lwa_conop-coltab.

      ENDIF."lwa_conop-conflict IS NOT INITIAL

      IF lwa_conop-tx_conflict EQ TEXT-077.

        lwa_col-fieldname = 'TX_CONFLICT'.
        lwa_col-color-col = 5.
        lwa_col-color-int = 1.
        lwa_col-color-inv = 0.
        APPEND lwa_col TO lwa_conop-coltab.

      ELSEIF lwa_conop-tx_conflict EQ TEXT-076.

        lwa_col-fieldname = 'TX_CONFLICT'.
        lwa_col-color-col = 6.
        lwa_col-color-int = 1.
        lwa_col-color-inv = 0.
        APPEND lwa_col TO lwa_conop-coltab.

      ENDIF."lwa_conop-conflict IS NOT INITIAL

      APPEND lwa_conop TO lit_conop.

    ENDLOOP. "it_rfc_confl ASSIGNING <lfs_rfc_confl>.

  ENDLOOP. "AT lit_prog ASSIGNING <lfs_prog>.

  APPEND LINES OF lit_conop TO fp_it_conop.
*  fp_it_conop[] = lit_conop[].

ENDFORM. "z_compare_prog

*&---------------------------------------------------------------------*
*&      Form  z_compare_clas
*&---------------------------------------------------------------------*
*       Logic for code comparison utility - Classes
*----------------------------------------------------------------------*

FORM z_compare_clas USING    fp_it_clas  TYPE ty_tadir
                    CHANGING fp_it_conop TYPE ty_conf_output.

  DATA: l_objname  TYPE trobj_name,
        l_reptname TYPE c LENGTH 32,
        l_objtype  TYPE vrsd-objtype,
        l_conf     TYPE c LENGTH 1,
        l_tx_confl TYPE c LENGTH 1,
        l_table    TYPE dd02l-tabname.

  DATA: r_ctrfc TYPE RANGE OF rfcdes-rfcdest.

  TYPES: BEGIN OF lt_class,
           classname  TYPE seoclsname,
           methodindx TYPE seomtdindx,
           methodname TYPE seocpdname,
         END OF lt_class.

  DATA: lit_class   TYPE TABLE OF lt_class,
        lit_conop   TYPE TABLE OF t_conf_output,
        lit_tadir   TYPE TABLE OF t_tadir,
        lit_clas    TYPE TABLE OF t_tadir_class,
*        lit_clas  TYPE TABLE OF t_tadir,
        lit_fld     TYPE TABLE OF rfc_db_fld,
        lit_opt     TYPE TABLE OF rfc_db_opt,
        lit_data    TYPE TABLE OF tab512,

        lwa_conop   TYPE t_conf_output,
        lwa_tadir   TYPE t_tadir,
        lwa_opt     TYPE rfc_db_opt,
        lwa_fld     TYPE rfc_db_fld,
        lwa_col     TYPE slis_specialcol_alv,
        lwa_class   TYPE lt_class,
        lwa_itclass TYPE t_tadir_class.

  FIELD-SYMBOLS: <lfs_class>     TYPE lt_class,
                 <lfs_clas>      TYPE t_tadir_class,
                 <lfs_rfc_confl> TYPE t_rfc_confl,
                 <lfs_ctrfc>     LIKE LINE OF r_ctrfc,
                 <lfs_data>      TYPE tab512.

  LOOP AT fp_it_clas ASSIGNING FIELD-SYMBOL(<lfs_itclass>).

    lwa_itclass-pgmid = <lfs_itclass>-pgmid.
    lwa_itclass-object = <lfs_itclass>-object.
    lwa_itclass-obj_name = <lfs_itclass>-obj_name.
    lwa_itclass-author = <lfs_itclass>-author.
    lwa_itclass-devclass = <lfs_itclass>-devclass.

    APPEND lwa_itclass TO lit_clas.

  ENDLOOP."fp_it_class ASSIGNING FIELD-SYMBOL(<lfs_itclass>)

*  lit_clas[] = fp_it_clas[].

* Get all methods from the current system

  IF lit_clas IS NOT INITIAL.

    SELECT classname methodindx methodname
      FROM tmdir
      INTO TABLE lit_class
      FOR ALL ENTRIES IN lit_clas
      WHERE classname EQ lit_clas-obj_name.

    IF sy-subrc EQ 0.
      SORT lit_class BY classname methodindx methodname.
    ENDIF."sy-subrc NE 0

  ENDIF. "lit_clas IS NOT INITIAL

* Get all methods from the target system

  l_table = 'TMDIR'.

  CLEAR: lwa_fld.
  MOVE: 'CLASSNAME' TO  lwa_fld-fieldname,
        '30'        TO  lwa_fld-length.
  APPEND  lwa_fld TO lit_fld.

  CLEAR: lwa_fld.
  MOVE: 'METHODINDX' TO  lwa_fld-fieldname,
        '5'        TO  lwa_fld-length.
  APPEND  lwa_fld TO lit_fld.

  CLEAR: lwa_fld.
  MOVE: 'METHODNAME' TO  lwa_fld-fieldname,
        '61'        TO  lwa_fld-length.
  APPEND  lwa_fld TO lit_fld.

  LOOP AT lit_clas ASSIGNING <lfs_clas>.

    IF <lfs_clas> IS ASSIGNED.

*     Create the WHERE Clause

      CLEAR: lwa_opt.
      CONCATENATE 'CLASSNAME EQ ''' <lfs_clas>-obj_name c_comma  INTO lwa_opt-text.
      APPEND lwa_opt TO lit_opt.
      CLEAR: lwa_opt.

*     Need to get method names from all target systems entered on selection screen

      LOOP AT s_ctrfc ASSIGNING <lfs_ctrfc>.

        CALL FUNCTION 'RFC_READ_TABLE' DESTINATION <lfs_ctrfc>-low
          EXPORTING
            query_table          = l_table
          TABLES
            options              = lit_opt
            fields               = lit_fld
            data                 = lit_data
          EXCEPTIONS
            table_not_available  = 1
            table_without_data   = 2
            option_not_valid     = 3
            field_not_valid      = 4
            not_authorized       = 5
            data_buffer_exceeded = 6
            OTHERS               = 7.
        IF sy-subrc NE 0.
          CLEAR: lit_data.
        ENDIF. "<lfs_clas> IS ASSIGNED.

        LOOP AT lit_data ASSIGNING <lfs_data>.

          IF <lfs_data> IS ASSIGNED.
            CLEAR: lwa_class.
            MOVE: <lfs_data>+0(30)   TO lwa_class-classname,
                  <lfs_data>+30(5)   TO lwa_class-methodindx,
                  <lfs_data>+35(61)  TO lwa_class-methodname.

*           Add the method only if it is not there in the source system


            READ TABLE lit_class ASSIGNING <lfs_class> FROM lwa_class.
            IF sy-subrc NE 0.
              APPEND lwa_class TO lit_class.
            ENDIF. "sy-subrc NE 0.

          ENDIF. "<lfs_data> IS ASSIGNED

        ENDLOOP. "lit_data ASSIGNING <lfs_data>.

      ENDLOOP. "s_ctrfc ASSIGNING <lfs_ctrfc>.

    ENDIF. "<lfs_clas> IS ASSIGNED.

  ENDLOOP. "lit_clas ASSIGNING <lfs_clas>.
  IF lit_class IS NOT INITIAL.

    DELETE lit_class WHERE methodname IS INITIAL.

    LOOP AT lit_class ASSIGNING <lfs_class>.

      CLEAR: l_objname, l_reptname.

      CONCATENATE <lfs_class>-classname <lfs_class>-methodname INTO l_objname RESPECTING BLANKS.
      l_objtype = c_meth.

      CONCATENATE <lfs_class>-classname 'CP' INTO l_reptname RESPECTING BLANKS.
      TRANSLATE l_reptname USING ' ='.

      PERFORM z_compare_obj USING  l_objname l_reptname l_objtype.

      LOOP AT it_rfc_confl ASSIGNING <lfs_rfc_confl>.

        IF <lfs_rfc_confl> IS ASSIGNED.

          CLEAR: lwa_conop.

          lwa_conop-class       = <lfs_class>-classname.
          lwa_conop-obj_name    = <lfs_class>-classname.
          lwa_conop-methname    = <lfs_class>-methodname.
          lwa_conop-sub_obj     = <lfs_class>-methodname.
          lwa_conop-objtyp      = c_meth.

          SORT lit_clas BY obj_name.

          READ TABLE lit_clas ASSIGNING <lfs_clas>
          WITH KEY obj_name = <lfs_class>-classname BINARY SEARCH.
          IF sy-subrc EQ 0.

            lwa_conop-pck         = <lfs_clas>-devclass.
            lwa_conop-author      = <lfs_clas>-author.

          ENDIF. "sy-subrc EQ 0.

          lwa_conop-rfcdest_s   = p_csrfc.
          lwa_conop-sourcetr    = <lfs_rfc_confl>-sourcetr.
          lwa_conop-sourcevr    = <lfs_rfc_confl>-sourcevr.
          lwa_conop-sourceauth  = <lfs_rfc_confl>-sourceauth.
          lwa_conop-sourcedt    = <lfs_rfc_confl>-sourcedt.
          lwa_conop-rfcdest     = <lfs_rfc_confl>-rfcdest.
          lwa_conop-targettr    = <lfs_rfc_confl>-targettr.
          lwa_conop-targetvr    = <lfs_rfc_confl>-targetvr.
          lwa_conop-targetdt    = <lfs_rfc_confl>-targetdt.
          lwa_conop-targetauth  = <lfs_rfc_confl>-targetauth.
          lwa_conop-conflict    = <lfs_rfc_confl>-conf_flag.
          lwa_conop-tx_conflict = <lfs_rfc_confl>-conf_flag_text.
          SORT it_obtab BY object.
          READ TABLE it_obtab ASSIGNING <lfs_obtab>
          WITH KEY object = lwa_conop-objtyp BINARY SEARCH.

          IF sy-subrc EQ 0.
            lwa_conop-objtypedesc = <lfs_obtab>-text.
          ENDIF. "sy-subrc EQ 0.

          CLEAR: lwa_col.

          IF lwa_conop-conflict EQ TEXT-077.

            lwa_col-fieldname = 'CONFLICT'.
            lwa_col-color-col = 5.
            lwa_col-color-int = 1.
            lwa_col-color-inv = 0.
            APPEND lwa_col TO lwa_conop-coltab.

          ELSEIF lwa_conop-conflict EQ TEXT-076.

            lwa_col-fieldname = 'CONFLICT'.
            lwa_col-color-col = 6.
            lwa_col-color-int = 1.
            lwa_col-color-inv = 0.
            APPEND lwa_col TO lwa_conop-coltab.

          ENDIF."lwa_conop-conflict IS NOT INITIAL

          IF lwa_conop-tx_conflict EQ TEXT-077.

            lwa_col-fieldname = 'TX_CONFLICT'.
            lwa_col-color-col = 5.
            lwa_col-color-int = 1.
            lwa_col-color-inv = 0.
            APPEND lwa_col TO lwa_conop-coltab.

          ELSEIF lwa_conop-tx_conflict EQ TEXT-076.

            lwa_col-fieldname = 'TX_CONFLICT'.
            lwa_col-color-col = 6.
            lwa_col-color-int = 1.
            lwa_col-color-inv = 0.
            APPEND lwa_col TO lwa_conop-coltab.

          ENDIF."lwa_conop-conflict IS NOT INITIAL

          APPEND lwa_conop TO lit_conop.

        ENDIF. "<lfs_rfc_confl> IS ASSIGNED

      ENDLOOP. "it_rfc_confl ASSIGNING <lfs_rfc_confl>

    ENDLOOP. "lit_class ASSIGNING <lfs_class>.

  ENDIF." sy-subrc EQ 0 AND lit_class IS NOT INITIAL.

  APPEND LINES OF lit_conop TO fp_it_conop.

ENDFORM. "z_compare_clas

